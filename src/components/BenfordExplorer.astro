---
---

<div class="bf-exp">
  <div class="bf-exp-tabs" role="tablist"></div>
  <div class="bf-exp-scene"></div>
  <div class="bf-exp-stats">
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">digit 1</div>
      <div class="bf-exp-stat-val bf-exp-d1">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">n</div>
      <div class="bf-exp-stat-val bf-exp-n">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">MAD</div>
      <div class="bf-exp-stat-val bf-exp-mad">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">fit</div>
      <div class="bf-exp-stat-val bf-exp-fit">—</div>
    </div>
  </div>
  <div class="bf-exp-desc"></div>
</div>

<style>
  .bf-exp {
    border: 0.5px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: var(--font-sans);
  }
  .bf-exp-tabs {
    background: var(--color-panel);
    border-bottom: 0.5px solid var(--color-border);
    padding: 10px 14px;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 4px;
    scrollbar-width: none;
    align-items: center;
  }
  .bf-exp-tabs::-webkit-scrollbar { display: none; }
  :global(.bf-exp-tab) {
    font-size: 10.5px;
    padding: 4px 11px;
    border-radius: 20px;
    background: transparent;
    border: none;
    color: var(--color-ink-4);
    cursor: pointer;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
    line-height: 1.6;
  }
  :global(.bf-exp-tab:hover) {
    background: var(--color-tag-bg);
    color: var(--color-ink-2);
  }
  :global(.bf-exp-tab[aria-selected='true']) {
    background: var(--color-ink);
    color: var(--color-surface);
    font-weight: 500;
  }
  .bf-exp-scene { background: var(--color-surface); }
  .bf-exp-stats {
    display: flex;
    background: var(--color-panel);
    border-top: 0.5px solid var(--color-border);
  }
  .bf-exp-stat {
    flex: 1;
    padding: 10px 14px;
    border-right: 0.5px solid var(--color-border);
    text-align: center;
  }
  .bf-exp-stat:last-child { border-right: none; }
  .bf-exp-stat-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-5);
    margin-bottom: 3px;
  }
  .bf-exp-stat-val {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .fit-good       { color: #34c759; }
  .fit-close      { color: #ff9500; }
  .fit-suspicious { color: #ff3b30; }
  .bf-exp-desc {
    background: var(--color-surface);
    border-top: 0.5px solid var(--color-border-soft);
    padding: 9px 16px;
    font-size: 11px;
    color: var(--color-ink-5);
    font-style: italic;
    font-family: var(--font-display);
    text-align: center;
    min-height: 32px;
  }
</style>

<script>
  import * as Plot from '@observablehq/plot'
  import { DATASETS, madScore, fitLabel } from '../lib/benford'

  const BAR   = '#aeaeb2'
  const CURVE = '#5856d6'
  const BG    = '#f7f7fa'
  const LABEL = '#8e8e9a'

  const CURVE_PTS = Array.from({ length: 100 }, (_, i) => {
    const d = 1 + 8 * i / 99
    return { d, freq: Math.log10(1 + 1 / d) }
  })

  function renderChart(container: HTMLElement, freqs: number[], height: number): void {
    const w = container.clientWidth || 480
    const rects = freqs.map((freq, i) => ({ x1: i + 1 - 0.38, x2: i + 1 + 0.38, freq }))
    const dots  = freqs.map((freq, i) => ({ digit: i + 1, freq }))

    const svg = Plot.plot({
      width: w,
      height,
      marginLeft: 44,
      marginBottom: 28,
      marginTop: 14,
      marginRight: 12,
      style: {
        background: BG,
        fontSize: '11px',
        fontFamily: 'var(--font-sans, system-ui)',
        overflow: 'visible',
      },
      x: {
        label: null,
        domain: [0.5, 9.5],
        ticks: [1, 2, 3, 4, 5, 6, 7, 8, 9],
        tickFormat: (d: number) => String(d),
        tickSize: 3,
      },
      y: {
        label: null,
        domain: [0, 0.34],
        tickFormat: (d: number) => (d * 100).toFixed(0) + '%',
        grid: true,
        tickSize: 0,
      },
      marks: [
        Plot.rectY(rects, { x1: 'x1', x2: 'x2', y: 'freq', fill: BAR }),
        Plot.line(CURVE_PTS, { x: 'd', y: 'freq', stroke: CURVE, strokeWidth: 1.25, strokeDasharray: '5,4' }),
        Plot.dot(dots, { x: 'digit', y: 'freq', fill: CURVE, r: 3 }),
      ],
    })

    svg.querySelectorAll('text').forEach(el => { el.setAttribute('fill', LABEL) })
    container.innerHTML = ''
    container.appendChild(svg)
  }

  function initExplorer(container: HTMLElement): void {
    const tabsEl  = container.querySelector('.bf-exp-tabs')  as HTMLElement
    const sceneEl = container.querySelector('.bf-exp-scene') as HTMLElement
    const d1El    = container.querySelector('.bf-exp-d1')    as HTMLElement
    const nEl     = container.querySelector('.bf-exp-n')     as HTMLElement
    const madEl   = container.querySelector('.bf-exp-mad')   as HTMLElement
    const fitEl   = container.querySelector('.bf-exp-fit')   as HTMLElement
    const descEl  = container.querySelector('.bf-exp-desc')  as HTMLElement

    DATASETS.forEach((ds, i) => {
      const btn = document.createElement('button')
      btn.className = 'bf-exp-tab'
      btn.textContent = ds.name
      btn.setAttribute('role', 'tab')
      btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
      btn.addEventListener('click', () => selectDataset(i))
      tabsEl.appendChild(btn)
    })
    const tabs = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>('.bf-exp-tab'))

    function selectDataset(idx: number): void {
      const ds  = DATASETS[idx]
      const mad = madScore(ds.digits)
      const fit = fitLabel(mad)

      tabs.forEach((t, i) => t.setAttribute('aria-selected', i === idx ? 'true' : 'false'))
      renderChart(sceneEl, ds.digits, 280)

      d1El.textContent   = (ds.digits[0] * 100).toFixed(1) + '%'
      nEl.textContent    = ds.n.toLocaleString()
      madEl.textContent  = mad.toFixed(4)
      fitEl.textContent  = fit
      fitEl.className    = 'bf-exp-stat-val bf-exp-fit fit-' + fit.toLowerCase()
      descEl.textContent = ds.description
    }

    selectDataset(0)
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.bf-exp:not([data-initialized])').forEach(el => {
      initExplorer(el)
      el.setAttribute('data-initialized', 'true')
    })
  })
</script>
