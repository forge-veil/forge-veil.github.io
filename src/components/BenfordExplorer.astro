---
---

<div class="bf-exp">
  <div class="bf-exp-tabs" role="tablist"></div>
  <div class="bf-exp-scene"></div>
  <div class="bf-exp-stats">
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">digit 1</div>
      <div class="bf-exp-stat-val bf-exp-d1">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">n</div>
      <div class="bf-exp-stat-val bf-exp-n">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">MAD</div>
      <div class="bf-exp-stat-val bf-exp-mad">—</div>
    </div>
    <div class="bf-exp-stat">
      <div class="bf-exp-stat-lbl">fit</div>
      <div class="bf-exp-stat-val bf-exp-fit">—</div>
    </div>
  </div>
  <div class="bf-exp-desc"></div>
</div>

<dialog class="bf-exp-modal">
  <div class="bf-exp-modal-header">
    <span class="bf-exp-modal-title">Data collection</span>
    <button class="bf-exp-modal-close" aria-label="Close">✕</button>
  </div>
  <div class="bf-exp-modal-meta">
    <span class="bf-exp-modal-fetched"></span>
    <a class="bf-exp-modal-src" href="#" target="_blank" rel="noopener noreferrer">source ↗</a>
  </div>
  <pre class="bf-exp-modal-code"></pre>
</dialog>

<style>
  .bf-exp {
    border: 0.5px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: var(--font-sans);
  }
  .bf-exp-tabs {
    background: var(--color-panel);
    border-bottom: 0.5px solid var(--color-border);
    padding: 10px 14px;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 4px;
    scrollbar-width: none;
    align-items: center;
  }
  .bf-exp-tabs::-webkit-scrollbar { display: none; }
  :global(.bf-exp-tab) {
    font-size: 10.5px;
    padding: 4px 11px;
    border-radius: 20px;
    background: transparent;
    border: none;
    color: var(--color-ink-4);
    cursor: pointer;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
    transition: background 0.12s, color 0.12s;
    white-space: nowrap;
    line-height: 1.6;
  }
  :global(.bf-exp-tab:hover) {
    background: var(--color-tag-bg);
    color: var(--color-ink-2);
  }
  :global(.bf-exp-tab[aria-selected='true']) {
    background: var(--color-ink);
    color: var(--color-surface);
    font-weight: 500;
  }
  .bf-exp-scene { background: var(--color-surface); }
  .bf-exp-stats {
    display: flex;
    background: var(--color-panel);
    border-top: 0.5px solid var(--color-border);
  }
  .bf-exp-stat {
    flex: 1;
    padding: 10px 14px;
    border-right: 0.5px solid var(--color-border);
    text-align: center;
  }
  .bf-exp-stat:last-child { border-right: none; }
  .bf-exp-stat-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-5);
    margin-bottom: 3px;
  }
  .bf-exp-stat-val {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .fit-good       { color: #34c759; }
  .fit-close      { color: #ff9500; }
  .fit-suspicious { color: #ff3b30; }
  .bf-exp-desc {
    background: var(--color-surface);
    border-top: 0.5px solid var(--color-border-soft);
    padding: 9px 16px;
    font-size: 11px;
    color: var(--color-ink-5);
    font-style: italic;
    font-family: var(--font-display);
    text-align: center;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  :global(.bf-exp-desc-text) {
    display: contents;
  }
  :global(.bf-exp-desc a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  :global(.bf-exp-code-btn) {
    font-size: 10px;
    font-family: var(--font-sans);
    font-style: normal;
    color: var(--color-ink-5);
    background: var(--color-tag-bg);
    border: none;
    border-radius: 4px;
    padding: 2px 7px;
    cursor: pointer;
    letter-spacing: 0.02em;
    flex-shrink: 0;
    transition: background 0.12s, color 0.12s;
  }
  :global(.bf-exp-code-btn:hover) {
    background: var(--color-border);
    color: var(--color-ink-2);
  }

  /* ── modal ── */
  .bf-exp-modal {
    border: 0.5px solid var(--color-border);
    border-radius: 12px;
    padding: 0;
    max-width: min(640px, 92vw);
    width: 100%;
    background: var(--color-surface);
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    font-family: var(--font-sans);
  }
  .bf-exp-modal::backdrop {
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(2px);
  }
  .bf-exp-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px 12px;
    border-bottom: 0.5px solid var(--color-border);
  }
  .bf-exp-modal-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-ink-2);
    text-transform: uppercase;
  }
  .bf-exp-modal-close {
    font-size: 13px;
    line-height: 1;
    color: var(--color-ink-4);
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 4px;
  }
  .bf-exp-modal-close:hover { background: var(--color-tag-bg); color: var(--color-ink-2); }
  .bf-exp-modal-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 18px;
    border-bottom: 0.5px solid var(--color-border-soft);
    background: var(--color-panel);
  }
  .bf-exp-modal-fetched {
    font-size: 10.5px;
    color: var(--color-ink-4);
    font-variant-numeric: tabular-nums;
  }
  .bf-exp-modal-src {
    font-size: 10.5px;
    color: var(--color-ink-4);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bf-exp-modal-code {
    margin: 0;
    padding: 16px 18px;
    font-family: var(--font-mono, 'SF Mono', 'Fira Mono', monospace);
    font-size: 11.5px;
    line-height: 1.65;
    color: var(--color-ink-2);
    white-space: pre;
    overflow-x: auto;
    background: var(--color-surface);
    border-radius: 0 0 12px 12px;
  }
</style>

<script>
  import * as Plot from '@observablehq/plot'
  import { DATASETS, madScore, fitLabel } from '../lib/benford'

  const BAR   = '#aeaeb2'
  const CURVE = '#5856d6'
  const BG    = '#f7f7fa'
  const LABEL = '#8e8e9a'

  const CURVE_PTS = Array.from({ length: 100 }, (_, i) => {
    const d = 1 + 8 * i / 99
    return { d, freq: Math.log10(1 + 1 / d) }
  })

  function renderChart(container: HTMLElement, freqs: number[], height: number): void {
    const w = container.clientWidth || 480
    const rects = freqs.map((freq, i) => ({ x1: i + 1 - 0.38, x2: i + 1 + 0.38, freq }))
    const dots  = freqs.map((freq, i) => ({ digit: i + 1, freq }))

    const svg = Plot.plot({
      width: w,
      height,
      marginLeft: 44,
      marginBottom: 28,
      marginTop: 14,
      marginRight: 12,
      style: {
        background: BG,
        fontSize: '11px',
        fontFamily: 'var(--font-sans, system-ui)',
        overflow: 'visible',
      },
      x: {
        label: null,
        domain: [0.5, 9.5],
        ticks: [1, 2, 3, 4, 5, 6, 7, 8, 9],
        tickFormat: (d: number) => String(d),
        tickSize: 3,
      },
      y: {
        label: null,
        domain: [0, 0.34],
        tickFormat: (d: number) => (d * 100).toFixed(0) + '%',
        grid: true,
        tickSize: 0,
      },
      marks: [
        Plot.rectY(rects, { x1: 'x1', x2: 'x2', y: 'freq', fill: BAR }),
        Plot.line(CURVE_PTS, { x: 'd', y: 'freq', stroke: CURVE, strokeWidth: 1.25, strokeDasharray: '5,4' }),
        Plot.dot(dots, { x: 'digit', y: 'freq', fill: CURVE, r: 3 }),
      ],
    })

    svg.querySelectorAll('text').forEach(el => { el.setAttribute('fill', LABEL) })
    container.innerHTML = ''
    container.appendChild(svg)
  }

  function formatDate(iso: string): string {
    return new Date(iso).toLocaleString('en-GB', {
      day: 'numeric', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
    })
  }

  function initExplorer(container: HTMLElement): void {
    const tabsEl   = container.querySelector('.bf-exp-tabs')   as HTMLElement
    const sceneEl  = container.querySelector('.bf-exp-scene')  as HTMLElement
    const d1El     = container.querySelector('.bf-exp-d1')     as HTMLElement
    const nEl      = container.querySelector('.bf-exp-n')      as HTMLElement
    const madEl    = container.querySelector('.bf-exp-mad')    as HTMLElement
    const fitEl    = container.querySelector('.bf-exp-fit')    as HTMLElement
    const descEl   = container.querySelector('.bf-exp-desc')   as HTMLElement

    // modal elements (shared, outside the widget)
    const modal     = document.querySelector('.bf-exp-modal')      as HTMLDialogElement
    const modalCode = modal.querySelector('.bf-exp-modal-code')    as HTMLElement
    const modalFetched = modal.querySelector('.bf-exp-modal-fetched') as HTMLElement
    const modalSrc  = modal.querySelector('.bf-exp-modal-src')     as HTMLAnchorElement
    const modalClose = modal.querySelector('.bf-exp-modal-close')  as HTMLButtonElement

    modalClose.addEventListener('click', () => modal.close())
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.close() })

    DATASETS.forEach((ds, i) => {
      const btn = document.createElement('button')
      btn.className = 'bf-exp-tab'
      btn.textContent = ds.name
      btn.setAttribute('role', 'tab')
      btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
      btn.addEventListener('click', () => selectDataset(i))
      tabsEl.appendChild(btn)
    })
    const tabs = Array.from(tabsEl.querySelectorAll<HTMLButtonElement>('.bf-exp-tab'))

    function selectDataset(idx: number): void {
      const ds  = DATASETS[idx]
      const mad = madScore(ds.digits)
      const fit = fitLabel(mad)

      tabs.forEach((t, i) => t.setAttribute('aria-selected', i === idx ? 'true' : 'false'))
      renderChart(sceneEl, ds.digits, 280)

      d1El.textContent  = (ds.digits[0] * 100).toFixed(1) + '%'
      nEl.textContent   = ds.n.toLocaleString()
      madEl.textContent = mad.toFixed(4)
      fitEl.textContent = fit
      fitEl.className   = 'bf-exp-stat-val bf-exp-fit fit-' + fit.toLowerCase()

      const codeBtn = document.createElement('button')
      codeBtn.className = 'bf-exp-code-btn'
      codeBtn.textContent = '{ } how collected'
      codeBtn.addEventListener('click', () => {
        modalCode.textContent  = ds.queryCode
        modalFetched.textContent = 'Fetched ' + formatDate(ds.fetchedAt)
        modalSrc.href = ds.source
        modal.showModal()
      })

      descEl.innerHTML = ''
      const text = document.createElement('span')
      text.className = 'bf-exp-desc-text'
      text.innerHTML = `${ds.description} — <a href="${ds.source}" target="_blank" rel="noopener noreferrer">source ↗</a>`
      descEl.appendChild(text)
      descEl.appendChild(codeBtn)
    }

    selectDataset(0)
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.bf-exp:not([data-initialized])').forEach(el => {
      initExplorer(el)
      el.setAttribute('data-initialized', 'true')
    })
  })
</script>
