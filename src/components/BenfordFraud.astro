---
---

<div class="bf-fraud">
  <div class="bf-fraud-scenes">
    <div class="bf-fraud-panel">
      <div class="bf-fraud-lbl">
        <span class="bf-fraud-dot" style="background:#34c759"></span>Real accounting data
      </div>
      <div class="bf-fraud-scene bf-fraud-left"></div>
      <div class="bf-fraud-stats">
        <span>MAD <strong class="bf-fraud-mad-l">—</strong></span>
        <span class="bf-fraud-fit" style="color:#34c759">Good fit ✓</span>
      </div>
    </div>
    <div class="bf-fraud-divider"></div>
    <div class="bf-fraud-panel">
      <div class="bf-fraud-lbl">
        <span class="bf-fraud-dot" style="background:#ff3b30"></span>Fabricated numbers
      </div>
      <div class="bf-fraud-scene bf-fraud-right"></div>
      <div class="bf-fraud-stats">
        <span>MAD <strong class="bf-fraud-mad-r">—</strong></span>
        <span class="bf-fraud-fit" style="color:#ff3b30">Suspicious ✗</span>
      </div>
    </div>
  </div>
  <div class="bf-fraud-caption">
    Humans invent "random" numbers with a strong bias toward mid-range digits (3, 5, 7) and actively avoid 1. Benford's Law catches the pattern.
  </div>
</div>

<style>
  .bf-fraud {
    border: 0.5px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: var(--font-sans);
  }
  .bf-fraud-scenes {
    display: flex;
    background: var(--color-surface);
    padding: 20px 20px 12px;
    gap: 0;
    align-items: flex-start;
  }
  .bf-fraud-panel { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .bf-fraud-divider {
    width: 0.5px;
    background: var(--color-border);
    margin: 0 20px;
    align-self: stretch;
  }
  .bf-fraud-lbl {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-ink-3);
  }
  .bf-fraud-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .bf-fraud-scene { position: relative; }
  .bf-fraud-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10.5px;
    color: var(--color-ink-4);
  }
  .bf-fraud-stats strong { color: var(--color-ink-2); }
  .bf-fraud-fit { font-weight: 500; font-size: 10px; }
  .bf-fraud-caption {
    background: var(--color-panel);
    border-top: 0.5px solid var(--color-border);
    padding: 12px 20px;
    font-size: 12px;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-ink-4);
    text-align: center;
  }
</style>

<script>
  import * as Plot from '@observablehq/plot'
  import { madScore } from '../lib/benford'

  const REAL_DIST  = [0.296, 0.179, 0.127, 0.099, 0.080, 0.068, 0.059, 0.050, 0.043]
  const FAKED_DIST = [0.048, 0.085, 0.183, 0.202, 0.191, 0.138, 0.085, 0.042, 0.026]

  const BAR   = '#aeaeb2'
  const CURVE = '#5856d6'
  const BG    = '#f7f7fa'
  const LABEL = '#8e8e9a'

  const CURVE_PTS = Array.from({ length: 100 }, (_, i) => {
    const d = 1 + 8 * i / 99
    return { d, freq: Math.log10(1 + 1 / d) }
  })

  function renderChart(container: HTMLElement, freqs: number[], height: number): void {
    const w = container.clientWidth || 300
    const rects = freqs.map((freq, i) => ({ x1: i + 1 - 0.38, x2: i + 1 + 0.38, freq }))
    const dots  = freqs.map((freq, i) => ({ digit: i + 1, freq }))

    const svg = Plot.plot({
      width: w,
      height,
      marginLeft: 44,
      marginBottom: 28,
      marginTop: 14,
      marginRight: 12,
      style: {
        background: BG,
        fontSize: '11px',
        fontFamily: 'var(--font-sans, system-ui)',
        overflow: 'visible',
      },
      x: {
        label: null,
        domain: [0.5, 9.5],
        ticks: [1, 2, 3, 4, 5, 6, 7, 8, 9],
        tickFormat: (d: number) => String(d),
        tickSize: 3,
      },
      y: {
        label: null,
        domain: [0, 0.34],
        tickFormat: (d: number) => (d * 100).toFixed(0) + '%',
        grid: true,
        tickSize: 0,
      },
      marks: [
        Plot.rectY(rects, { x1: 'x1', x2: 'x2', y: 'freq', fill: BAR }),
        Plot.line(CURVE_PTS, { x: 'd', y: 'freq', stroke: CURVE, strokeWidth: 1.25, strokeDasharray: '5,4' }),
        Plot.dot(dots, { x: 'digit', y: 'freq', fill: CURVE, r: 3 }),
      ],
    })

    svg.querySelectorAll('text').forEach(el => { (el as HTMLElement).style.fill = LABEL })
    container.innerHTML = ''
    container.appendChild(svg)
  }

  function initFraud(container: HTMLElement): void {
    const madLEl  = container.querySelector('.bf-fraud-mad-l') as HTMLElement
    const madREl  = container.querySelector('.bf-fraud-mad-r') as HTMLElement
    const leftEl  = container.querySelector('.bf-fraud-left')  as HTMLElement
    const rightEl = container.querySelector('.bf-fraud-right') as HTMLElement

    renderChart(leftEl,  REAL_DIST,  180)
    renderChart(rightEl, FAKED_DIST, 180)

    madLEl.textContent = madScore(REAL_DIST).toFixed(4)
    madREl.textContent = madScore(FAKED_DIST).toFixed(4)
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.bf-fraud:not([data-initialized])').forEach(el => {
      initFraud(el)
      el.setAttribute('data-initialized', 'true')
    })
  })
</script>
