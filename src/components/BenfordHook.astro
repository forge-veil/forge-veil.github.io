---
---

<div class="bf-hook">
  <div class="bf-hook-scene"></div>
  <div class="bf-hook-footer">
    <div class="bf-hook-counter">
      <span class="bf-hook-n">0</span> Fibonacci numbers streamed
    </div>
    <button class="bf-hook-replay">replay</button>
  </div>
</div>

<style>
  .bf-hook {
    border: 0.5px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: var(--font-sans);
  }
  .bf-hook-scene {
    width: 100%;
    background: var(--color-surface);
    position: relative;
  }
  .bf-hook-footer {
    background: var(--color-panel);
    border-top: 0.5px solid var(--color-border);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bf-hook-counter {
    font-size: 12px;
    color: var(--color-ink-4);
    font-variant-numeric: tabular-nums;
  }
  .bf-hook-n {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
    min-width: 3ch;
    display: inline-block;
    text-align: right;
  }
  .bf-hook-replay {
    font-size: 11px;
    font-family: var(--font-sans);
    color: var(--color-ink-4);
    background: var(--color-tag-bg);
    border: none;
    border-radius: 5px;
    padding: 4px 10px;
    cursor: pointer;
    letter-spacing: 0.02em;
  }
  .bf-hook-replay:hover { background: var(--color-border); }
</style>

<script>
  import * as Plot from '@observablehq/plot'

  const BAR   = '#aeaeb2'
  const CURVE = '#5856d6'
  const BG    = '#f7f7fa'
  const LABEL = '#8e8e9a'

  const CURVE_PTS = Array.from({ length: 100 }, (_, i) => {
    const d = 1 + 8 * i / 99
    return { d, freq: Math.log10(1 + 1 / d) }
  })

  function renderChart(container: HTMLElement, counts: number[], total: number): void {
    const w = container.clientWidth || 480
    const freqs = counts.map(c => total > 0 ? c / total : 0)
    const rects = freqs.map((freq, i) => ({ x1: i + 1 - 0.38, x2: i + 1 + 0.38, freq }))
    const dots  = freqs.map((freq, i) => ({ digit: i + 1, freq }))

    const svg = Plot.plot({
      width: w,
      height: 280,
      marginLeft: 44,
      marginBottom: 28,
      marginTop: 14,
      marginRight: 12,
      style: {
        background: BG,
        fontSize: '11px',
        fontFamily: 'var(--font-sans, system-ui)',
        overflow: 'visible',
      },
      x: {
        label: null,
        domain: [0.5, 9.5],
        ticks: [1, 2, 3, 4, 5, 6, 7, 8, 9],
        tickFormat: (d: number) => String(d),
        tickSize: 3,
      },
      y: {
        label: null,
        domain: [0, 0.34],
        tickFormat: (d: number) => (d * 100).toFixed(0) + '%',
        grid: true,
        tickSize: 0,
      },
      marks: [
        Plot.rectY(rects, { x1: 'x1', x2: 'x2', y: 'freq', fill: BAR }),
        Plot.line(CURVE_PTS, { x: 'd', y: 'freq', stroke: CURVE, strokeWidth: 1.25, strokeDasharray: '5,4' }),
        Plot.dot(dots, { x: 'digit', y: 'freq', fill: CURVE, r: 3 }),
      ],
    })

    svg.querySelectorAll('text').forEach(el => { (el as HTMLElement).style.fill = LABEL })
    container.innerHTML = ''
    container.appendChild(svg)
  }

  function initHook(container: HTMLElement): void {
    const sceneEl   = container.querySelector('.bf-hook-scene')  as HTMLElement
    const nEl       = container.querySelector('.bf-hook-n')      as HTMLElement
    const replayBtn = container.querySelector('.bf-hook-replay') as HTMLButtonElement

    // Pre-compute 500 Fibonacci first digits using BigInt (avoids floating-point precision loss)
    function fibFirstDigits(count: number): number[] {
      const result: number[] = []
      let a = 1n, b = 1n
      for (let i = 0; i < count; i++) {
        result.push(parseInt(a.toString()[0]))
        ;[a, b] = [b, a + b]
      }
      return result
    }
    const FIB_DIGITS = fibFirstDigits(500)

    const counts = new Array(9).fill(0)
    let idx = 0, lastTime = 0, animId = 0

    function tick(time: number): void {
      if (idx >= FIB_DIGITS.length) return
      animId = requestAnimationFrame(tick)
      if (time - lastTime > 33) {
        const batch = Math.min(4, FIB_DIGITS.length - idx)
        for (let k = 0; k < batch; k++) { counts[FIB_DIGITS[idx] - 1]++; idx++ }
        nEl.textContent = String(idx)
        renderChart(sceneEl, counts, idx)
        lastTime = time
      }
    }

    function start(): void {
      cancelAnimationFrame(animId)
      counts.fill(0)
      idx = 0
      lastTime = 0
      nEl.textContent = '0'
      renderChart(sceneEl, counts, 0)
      animId = requestAnimationFrame(tick)
    }

    replayBtn.addEventListener('click', start)

    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { start(); io.disconnect() }
    }, { threshold: 0.3 })
    io.observe(container)
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.bf-hook:not([data-initialized])').forEach(el => {
      initHook(el)
      el.setAttribute('data-initialized', 'true')
    })
  })
</script>
