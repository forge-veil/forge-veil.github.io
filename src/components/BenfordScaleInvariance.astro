---
---

<div class="bf-scale">
  <div class="bf-scale-scenes">
    <div class="bf-scale-panel">
      <div class="bf-scale-label">original</div>
      <div class="bf-scale-scene bf-scale-left"></div>
    </div>
    <div class="bf-scale-mid">
      <div class="bf-scale-factor">× <span class="bf-scale-val">1.0</span></div>
      <input type="range" class="bf-scale-sl" min="0" max="100" value="50" />
      <div class="bf-scale-hint">drag</div>
    </div>
    <div class="bf-scale-panel">
      <div class="bf-scale-label bf-scale-right-lbl">scaled → same!</div>
      <div class="bf-scale-scene bf-scale-right"></div>
    </div>
  </div>
  <div class="bf-scale-footer">
    <p class="bf-scale-caption">
      P(d) = log₁₀(1 + 1/d) is scale-invariant: multiplying every number by any constant leaves the first-digit distribution unchanged.
    </p>
  </div>
</div>

<style>
  .bf-scale {
    border: 0.5px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 2rem 0;
    font-family: var(--font-sans);
  }
  .bf-scale-scenes {
    display: flex;
    align-items: stretch;
    background: var(--color-surface);
    padding: 20px 16px 12px;
  }
  .bf-scale-panel { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .bf-scale-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-ink-5);
    text-align: center;
  }
  .bf-scale-right-lbl { color: #34c759; }
  .bf-scale-scene { position: relative; }
  .bf-scale-mid {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 12px;
    min-width: 80px;
  }
  .bf-scale-factor {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  .bf-scale-val { font-variant-numeric: tabular-nums; min-width: 5ch; display: inline-block; }
  input[type='range'].bf-scale-sl {
    writing-mode: vertical-lr;
    direction: rtl;
    height: 100px;
    -webkit-appearance: none;
    width: 4px;
    background: var(--color-tag-bg);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  input[type='range'].bf-scale-sl::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-ink-2);
    cursor: pointer;
  }
  .bf-scale-hint { font-size: 9px; color: var(--color-ink-6); letter-spacing: 0.04em; }
  .bf-scale-footer {
    background: var(--color-panel);
    border-top: 0.5px solid var(--color-border);
    padding: 12px 18px;
  }
  .bf-scale-caption {
    font-size: 12px;
    color: var(--color-ink-4);
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    text-align: center;
  }
</style>

<script>
  import * as Plot from '@observablehq/plot'
  import { distribution } from '../lib/benford'

  const BAR   = '#aeaeb2'
  const CURVE = '#5856d6'
  const BG    = '#f7f7fa'
  const LABEL = '#8e8e9a'

  const CURVE_PTS = Array.from({ length: 100 }, (_, i) => {
    const d = 1 + 8 * i / 99
    return { d, freq: Math.log10(1 + 1 / d) }
  })

  function renderChart(container: HTMLElement, freqs: number[], height: number): void {
    const w = container.clientWidth || 300
    const rects = freqs.map((freq, i) => ({ x1: i + 1 - 0.38, x2: i + 1 + 0.38, freq }))
    const dots  = freqs.map((freq, i) => ({ digit: i + 1, freq }))

    const svg = Plot.plot({
      width: w,
      height,
      marginLeft: 44,
      marginBottom: 28,
      marginTop: 14,
      marginRight: 12,
      style: {
        background: BG,
        fontSize: '11px',
        fontFamily: 'var(--font-sans, system-ui)',
        overflow: 'visible',
      },
      x: {
        label: null,
        domain: [0.5, 9.5],
        ticks: [1, 2, 3, 4, 5, 6, 7, 8, 9],
        tickFormat: (d: number) => String(d),
        tickSize: 3,
      },
      y: {
        label: null,
        domain: [0, 0.34],
        tickFormat: (d: number) => (d * 100).toFixed(0) + '%',
        grid: true,
        tickSize: 0,
      },
      marks: [
        Plot.rectY(rects, { x1: 'x1', x2: 'x2', y: 'freq', fill: BAR }),
        Plot.line(CURVE_PTS, { x: 'd', y: 'freq', stroke: CURVE, strokeWidth: 1.25, strokeDasharray: '5,4' }),
        Plot.dot(dots, { x: 'digit', y: 'freq', fill: CURVE, r: 3 }),
      ],
    })

    svg.querySelectorAll('text').forEach(el => { el.setAttribute('fill', LABEL) })
    container.innerHTML = ''
    container.appendChild(svg)
  }

  function initScale(container: HTMLElement): void {
    const leftEl  = container.querySelector('.bf-scale-left')  as HTMLElement
    const rightEl = container.querySelector('.bf-scale-right') as HTMLElement
    const slider  = container.querySelector('.bf-scale-sl')    as HTMLInputElement
    const valEl   = container.querySelector('.bf-scale-val')   as HTMLElement

    function fibNums(count: number): number[] {
      const nums: number[] = []
      let a = 1, b = 1
      for (let i = 0; i < count; i++) { nums.push(a); [a, b] = [b, a + b] }
      return nums
    }
    const FIB = fibNums(200)

    // Slider: 0 → 0.001, 50 → 1.0, 100 → 1000 (log scale)
    function sliderToScale(v: number): number {
      return Math.pow(10, (v - 50) / 16.667)
    }

    const origDist = distribution(FIB)
    renderChart(leftEl,  origDist, 200)
    renderChart(rightEl, origDist, 200)

    slider.addEventListener('input', () => {
      const scale = sliderToScale(parseFloat(slider.value))
      valEl.textContent = scale >= 100 ? scale.toFixed(0)
        : scale >= 10  ? scale.toFixed(1)
        : scale >= 1   ? scale.toFixed(2)
        : scale >= 0.1 ? scale.toFixed(3)
        : scale.toFixed(4)
      renderChart(rightEl, distribution(FIB.map(n => n * scale)), 200)
    })
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('.bf-scale:not([data-initialized])').forEach(el => {
      initScale(el)
      el.setAttribute('data-initialized', 'true')
    })
  })
</script>
