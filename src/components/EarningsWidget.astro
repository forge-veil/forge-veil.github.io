---
interface Props {
  ticker: string
  interactive?: boolean
  label?: string
}

const { ticker, interactive = false, label } = Astro.props
const id = `ew-${Math.random().toString(36).slice(2, 9)}`
---

{label && <div class="ew-label">{label}</div>}

<div
  class:list={['ew', !interactive && 'ew--compact']}
  data-ew-id={id}
  data-ticker={ticker}
  data-interactive={interactive ? 'true' : 'false'}
>
  <div class="ew-header">
    {interactive ? (
      <input
        class="ew-input"
        type="text"
        value={ticker}
        autocomplete="off"
        spellcheck="false"
        aria-label="Stock ticker"
      />
    ) : (
      <span class="ew-ticker-static">{ticker}</span>
    )}
    <span class="ew-name"></span>
    <span class="ew-price"></span>
  </div>

  <div class="ew-charts">
    <div class="ew-panel-price">
      <div class="ew-legend">
        <span class="ew-legend-price">— Price</span>
        <span class="ew-legend-eps">- - EPS (quarterly)</span>
      </div>
      <div class="ew-chart-price"></div>
    </div>
    <div class="ew-panel-pe">
      <div class="ew-legend">
        <span class="ew-legend-pe">— P/E (trailing)</span>
        <span class="ew-legend-avg">- - 4yr avg</span>
      </div>
      <div class="ew-chart-pe"></div>
    </div>
  </div>

  <div class="ew-stats">
    <div class="ew-stat">
      <div class="ew-stat-lbl">Current P/E</div>
      <div class="ew-stat-val ew-pe-val">—</div>
    </div>
    <div class="ew-stat ew-stat--full-only">
      <div class="ew-stat-lbl">EPS (TTM)</div>
      <div class="ew-stat-val ew-eps-val">—</div>
    </div>
    <div class="ew-stat">
      <div class="ew-stat-lbl">EPS growth</div>
      <div class="ew-stat-val ew-growth-val">—</div>
    </div>
    <div class="ew-stat ew-stat--full-only">
      <div class="ew-stat-lbl">16Q price Δ</div>
      <div class="ew-stat-val ew-pricedelta-val">—</div>
    </div>
  </div>

  <div class="ew-status" hidden></div>
</div>

<style>
  .ew-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-5);
    margin-bottom: 6px;
    margin-top: 20px;
  }

  .ew {
    border: 0.5px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-panel);
    font-family: var(--font-sans);
  }

  /* ── Header ── */
  .ew-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 0.5px solid var(--color-border);
  }

  .ew-input {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 0.5px solid var(--color-border);
    border-radius: 6px;
    padding: 4px 10px;
    background: var(--color-tag-bg);
    color: var(--color-ink);
    width: 88px;
    outline: none;
    transition: border-color 0.12s;
  }
  .ew-input:focus { border-color: var(--color-ink-4); }
  .ew-input--error { border-color: #ff3b30 !important; }

  .ew-ticker-static {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-ink);
  }

  .ew-name {
    font-size: 12px;
    color: var(--color-ink-4);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ew-price {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── Charts ── */
  .ew-panel-price { padding: 12px 16px 4px; }
  .ew-panel-pe {
    padding: 4px 16px 10px;
    border-top: 0.5px solid var(--color-border-soft);
  }

  .ew-legend {
    font-size: 9px;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
    display: flex;
    gap: 16px;
  }
  .ew-legend-price { color: var(--color-ink-2); }
  .ew-legend-eps   { color: var(--color-ink-5); }
  .ew-legend-pe    { color: var(--color-ink-4); }
  .ew-legend-avg   { color: #ff9500; }

  .ew-chart-price,
  .ew-chart-pe { width: 100%; min-height: 4px; }

  /* ── Stats bar ── */
  .ew-stats {
    display: flex;
    border-top: 0.5px solid var(--color-border);
  }

  .ew-stat {
    flex: 1;
    padding: 9px 12px;
    border-right: 0.5px solid var(--color-border);
    text-align: center;
  }
  .ew-stat:last-child { border-right: none; }

  .ew-stat-lbl {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-5);
    margin-bottom: 3px;
  }

  .ew-stat-val {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
  }

  .ew-up   { color: #34c759; }
  .ew-down { color: #ff3b30; }
  .ew-warn { color: #ff9500; }

  /* ── Status (loading / error) ── */
  .ew-status {
    padding: 18px 16px;
    text-align: center;
    font-size: 12px;
    color: var(--color-ink-5);
    border-top: 0.5px solid var(--color-border);
  }

  :global(.ew-retry) {
    margin: 6px auto 0;
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    padding: 4px 12px;
    border: 0.5px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-tag-bg);
    color: var(--color-ink-3);
    cursor: pointer;
    transition: background 0.12s;
  }
  :global(.ew-retry:hover) { background: var(--color-border); }

  /* ── Compact mode (non-interactive / sector grid) ── */
  .ew--compact .ew-stat--full-only { display: none; }
  .ew--compact .ew-header  { padding: 7px 12px; }
  .ew--compact .ew-panel-price { padding: 8px 10px 2px; }
  .ew--compact .ew-panel-pe    { padding: 2px 10px 6px; }
  .ew--compact .ew-legend      { display: none; }
  .ew--compact .ew-stat        { padding: 6px 8px; }
  .ew--compact .ew-stat-val    { font-size: 13px; }
  .ew--compact .ew-stat:nth-child(3) { border-right: none; }
</style>

<script>
import type { MergedQuarter } from '../lib/earnings'

const NS = 'http://www.w3.org/2000/svg'

function svgEl(tag: string, attrs: Record<string, string | number>): SVGElement {
  const e = document.createElementNS(NS, tag)
  for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v))
  return e
}

function scale(vMin: number, vMax: number, pxLow: number, pxHigh: number) {
  return (v: number) => pxLow + ((v - vMin) / (vMax - vMin)) * (pxHigh - pxLow)
}

function renderPriceEpsChart(
  container: HTMLElement,
  data: MergedQuarter[],
  compact: boolean
): void {
  const H = compact ? 68 : 172
  const P = compact
    ? { t: 4, r: 6, b: 4, l: 6 }
    : { t: 10, r: 44, b: 24, l: 44 }

  const W = container.clientWidth || 640
  const pw = W - P.l - P.r
  const ph = H - P.t - P.b

  const valid = data.filter(d => d.price != null)
  if (valid.length < 2) return

  const prices = valid.map(d => d.price)
  const epsPts = valid.filter(d => d.eps != null)

  const pMin = Math.min(...prices) * 0.92
  const pMax = Math.max(...prices) * 1.06
  const eMin = epsPts.length ? Math.min(0, ...epsPts.map(d => d.eps!)) * 1.1 : 0
  const eMax = epsPts.length ? Math.max(...epsPts.map(d => d.eps!)) * 1.2 : 1

  const xOf = (i: number) => P.l + (i / (valid.length - 1)) * pw
  const pyOf = scale(pMin, pMax, P.t + ph, P.t)
  const eyOf = scale(eMin, eMax, P.t + ph, P.t)

  const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}` })
  ;(svg as unknown as HTMLElement).style.cssText = 'display:block;width:100%'

  if (!compact) {
    // Horizontal grid lines
    for (let t = 0; t <= 3; t++) {
      const y = P.t + (t / 3) * ph
      svg.appendChild(svgEl('line', { x1: P.l, x2: P.l + pw, y1: y, y2: y, stroke: 'rgba(0,0,0,0.04)', 'stroke-width': 1 }))
    }
    // Price y-axis labels (left)
    for (let t = 0; t <= 3; t++) {
      const v = pMin + (t / 3) * (pMax - pMin)
      const y = P.t + ph - (t / 3) * ph + 3
      const label = v >= 1000 ? `$${(v / 1000).toFixed(1)}k` : `$${Math.round(v)}`
      const txt = svgEl('text', { x: P.l - 5, y, 'text-anchor': 'end', 'font-size': 8, fill: '#aeaeb2', 'font-family': 'sans-serif' })
      txt.textContent = label
      svg.appendChild(txt)
    }
    // EPS y-axis labels (right)
    for (let t = 0; t <= 3; t++) {
      const v = eMin + (t / 3) * (eMax - eMin)
      const y = P.t + ph - (t / 3) * ph + 3
      const txt = svgEl('text', { x: P.l + pw + 5, y, 'text-anchor': 'start', 'font-size': 8, fill: '#aeaeb2', 'font-family': 'sans-serif' })
      txt.textContent = `$${v.toFixed(1)}`
      svg.appendChild(txt)
    }
    // X-axis quarter labels (every 4th + last)
    valid.forEach((d, i) => {
      if (i % 4 !== 0 && i !== valid.length - 1) return
      const [yr, q] = d.quarter.split('-')
      const txt = svgEl('text', { x: xOf(i), y: H - 3, 'text-anchor': 'middle', 'font-size': 7.5, fill: '#aeaeb2', 'font-family': 'sans-serif' })
      txt.textContent = `${q}'${yr.slice(2)}`
      svg.appendChild(txt)
    })
  }

  // Price polyline
  svg.appendChild(svgEl('polyline', {
    points: valid.map((d, i) => `${xOf(i)},${pyOf(d.price)}`).join(' '),
    fill: 'none', stroke: '#1c1c1e', 'stroke-width': 1.5, 'stroke-linejoin': 'round',
  }))

  // Split EPS into contiguous non-null runs to avoid bridging gaps
  if (epsPts.length >= 2) {
    const runs: string[][] = []
    let current: string[] = []
    valid.forEach((d, i) => {
      if (d.eps != null) {
        current.push(`${xOf(i)},${eyOf(d.eps)}`)
      } else if (current.length > 0) {
        runs.push(current)
        current = []
      }
    })
    if (current.length > 0) runs.push(current)
    for (const run of runs) {
      if (run.length < 2) continue
      svg.appendChild(svgEl('polyline', {
        points: run.join(' '),
        fill: 'none', stroke: '#8e8e93', 'stroke-width': 1.5,
        'stroke-dasharray': '3,2', 'stroke-linejoin': 'round',
      }))
    }
  }

  container.innerHTML = ''
  container.appendChild(svg)
}

function renderPEChart(
  container: HTMLElement,
  data: MergedQuarter[],
  avgPE: number,
  compact: boolean
): void {
  const H = compact ? 48 : 92
  const P = compact
    ? { t: 4, r: 6, b: 4, l: 6 }
    : { t: 8, r: 44, b: 8, l: 44 }

  const W = container.clientWidth || 640
  const pw = W - P.l - P.r
  const ph = H - P.t - P.b

  const withPE = data.filter(d => d.trailingPE != null)
  if (withPE.length < 2) {
    if (!compact) {
      container.innerHTML = `<div style="height:${H}px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#aeaeb2">Insufficient EPS data for P/E</div>`
    }
    return
  }

  const peVals = withPE.map(d => d.trailingPE!)
  const peMin = Math.min(...peVals) * 0.85
  const peMax = Math.max(Math.max(...peVals) * 1.1, avgPE > 0 ? avgPE * 1.1 : 0)

  const xOf = (d: MergedQuarter) => P.l + (data.indexOf(d) / (data.length - 1)) * pw
  const pyOf = scale(peMin, peMax, P.t + ph, P.t)

  const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}` })
  ;(svg as unknown as HTMLElement).style.cssText = 'display:block;width:100%'

  if (!compact) {
    for (let t = 0; t <= 2; t++) {
      const y = P.t + (t / 2) * ph
      svg.appendChild(svgEl('line', { x1: P.l, x2: P.l + pw, y1: y, y2: y, stroke: 'rgba(0,0,0,0.04)', 'stroke-width': 1 }))
    }
    for (let t = 0; t <= 2; t++) {
      const v = peMin + (t / 2) * (peMax - peMin)
      const y = P.t + ph - (t / 2) * ph + 3
      const txt = svgEl('text', { x: P.l - 5, y, 'text-anchor': 'end', 'font-size': 8, fill: '#aeaeb2', 'font-family': 'sans-serif' })
      txt.textContent = `${Math.round(v)}×`
      svg.appendChild(txt)
    }
  }

  // 4yr average reference line
  if (avgPE > peMin && avgPE < peMax) {
    const avgY = pyOf(avgPE)
    svg.appendChild(svgEl('line', {
      x1: P.l, x2: P.l + pw, y1: avgY, y2: avgY,
      stroke: '#ff9500', 'stroke-width': 1, 'stroke-dasharray': '4,3', opacity: 0.7,
    }))
    if (!compact) {
      const txt = svgEl('text', { x: P.l + pw + 5, y: avgY + 3, 'text-anchor': 'start', 'font-size': 7.5, fill: '#ff9500', 'font-family': 'sans-serif' })
      txt.textContent = `${Math.round(avgPE)}×`
      svg.appendChild(txt)
    }
  }

  // P/E polyline
  svg.appendChild(svgEl('polyline', {
    points: withPE.map(d => `${xOf(d)},${pyOf(d.trailingPE!)}`).join(' '),
    fill: 'none', stroke: '#6e6e73', 'stroke-width': 1.5, 'stroke-linejoin': 'round',
  }))

  container.innerHTML = ''
  container.appendChild(svg)
}

</script>
