---
// src/components/GaussianSplatLab.astro
// Interactive centrepiece for "Painting with Gaussians". A reader builds a
// small scene from 3D Gaussians and watches them project (EWA Jacobian),
// depth-sort, and alpha-composite live on a plain Canvas 2D surface. All of
// the subtle math (covariance build, EWA projection, 2x2 inverse, the 2D
// Gaussian, front-to-back "over") lives in ../lib/splat and is imported here;
// this component only does presentation: the view matrix, the per-pixel
// compositing loop, and the controls.
import katex from 'katex';
import CodeModal from './CodeModal.astro';
const eqCov = katex.renderToString(
  String.raw`\Sigma \;=\; R\,S\,S^{\top} R^{\top}`,
  { displayMode: true, throwOnError: false }
);
const eqProj = katex.renderToString(
  String.raw`\Sigma' \;=\; J\,W\,\Sigma\,W^{\top} J^{\top}`,
  { displayMode: true, throwOnError: false }
);
---
<figure class="viz gslab">
  <div class="viz-row">
    <div class="viz-eq gs-eqs">
      <div class="gs-eq-line" set:html={eqCov} />
      <div class="gs-eq-line" set:html={eqProj} />
    </div>

    <div class="viz-render">
      <div class="gs-stage">
        <canvas class="gs-canvas" width="360" height="240"></canvas>
        <canvas class="gs-overlay"></canvas>
      </div>

      <div class="viz-controls gs-controls">
        <span class="gs-hint">Drag to orbit · click a blob to select</span>
        <label class="gs-field">length
          <input class="gs-along" type="range" min="0.05" max="1.2" step="0.01" value="0.5" disabled />
        </label>
        <label class="gs-field">width
          <input class="gs-across" type="range" min="0.05" max="1.2" step="0.01" value="0.5" disabled />
        </label>
        <label class="gs-field">opacity
          <input class="gs-opacity" type="range" min="0.1" max="1" step="0.01" value="0.85" disabled />
        </label>
        <label class="gs-check"><input class="gs-ellipses" type="checkbox" /> show ellipses</label>
      </div>

      <div class="viz-controls gs-controls">
        <button class="gs-btn gs-add" type="button">add Gaussian</button>
        <button class="gs-btn gs-remove" type="button" disabled>remove selected</button>
        <button class="gs-btn gs-reset" type="button">reset scene</button>
        <span class="gs-readout viz-readout">Selected: none</span>
      </div>
    </div>
  </div>

  <figcaption>
    Each Gaussian carries a 3D covariance Σ = R S Sᵀ Rᵀ. To draw it, the camera
    rotation W turns Σ into the camera frame and the perspective Jacobian J
    squashes it onto the screen as a 2D covariance Σ&#8242;. Blobs are sorted by
    depth and blended front to back. Tilt a flat disc edge-on and its footprint
    collapses to a sliver, which is exactly what the projected covariance says
    should happen. <CodeModal preset="ewa-projection" trigger="equations & code" />
  </figcaption>
</figure>

<script>
  import {
    covariance3D,
    projectCovariance,
    invMat2,
    gaussian2D,
    alphaOver,
  } from '../lib/splat';
  import type { Vec3, Mat3, Mat2, Quat, RGB } from '../lib/splat';

  // ── Scene model ──────────────────────────────────────────────────────
  type Splat = { pos: Vec3; scale: Vec3; quat: Quat; color: RGB; opacity: number };

  // Muted palette: ink tones plus two restrained accents (a slate blue and a
  // soft rust) so the composited result reads as one intentional soft object.
  const INK: RGB = [0.36, 0.36, 0.40];
  const INK_DARK: RGB = [0.22, 0.22, 0.27];
  const INK_LIGHT: RGB = [0.56, 0.56, 0.62];
  const BLUE: RGB = [0.30, 0.44, 0.60];
  const RUST: RGB = [0.64, 0.42, 0.32];

  // Unit-axis, angle → quaternion [w,x,y,z].
  function qAxis(ax: number, ay: number, az: number, angle: number): Quat {
    const h = angle / 2, s = Math.sin(h);
    return [Math.cos(h), ax * s, ay * s, az * s];
  }

  function defaultScene(): Splat[] {
    return [
      { pos: [0, 0, 0],           scale: [0.62, 0.62, 0.62], quat: [1, 0, 0, 0],                         color: INK,        opacity: 0.9 },
      { pos: [0.72, 0.24, 0.18],  scale: [0.72, 0.72, 0.12], quat: qAxis(1, 0, 0, Math.PI / 3),          color: BLUE,       opacity: 0.85 },
      { pos: [-0.62, 0.12, -0.28],scale: [0.5, 0.5, 0.5],    quat: [1, 0, 0, 0],                         color: RUST,       opacity: 0.82 },
      { pos: [0.18, 0.6, -0.2],   scale: [0.6, 0.2, 0.2],    quat: qAxis(0, 0, 1, Math.PI / 6),          color: INK_LIGHT,  opacity: 0.78 },
      { pos: [-0.32, -0.5, 0.3],  scale: [0.5, 0.5, 0.5],    quat: [1, 0, 0, 0],                         color: INK_DARK,   opacity: 0.85 },
      { pos: [0.36, -0.36, 0.5],  scale: [0.62, 0.62, 0.14], quat: qAxis(0, 1, 0, Math.PI / 4),          color: BLUE,       opacity: 0.72 },
    ];
  }

  // ── Small matrix helpers (row-major flat 3x3) ────────────────────────
  function mat3mul(A: Mat3, B: Mat3): Mat3 {
    const C = new Array(9) as unknown as Mat3;
    for (let r = 0; r < 3; r++)
      for (let c = 0; c < 3; c++)
        C[r * 3 + c] = A[r * 3] * B[c] + A[r * 3 + 1] * B[3 + c] + A[r * 3 + 2] * B[6 + c];
    return C;
  }
  function transpose3(A: Mat3): Mat3 {
    return [A[0], A[3], A[6], A[1], A[4], A[7], A[2], A[5], A[8]];
  }
  function mat3vec(A: Mat3, v: Vec3): Vec3 {
    return [
      A[0] * v[0] + A[1] * v[1] + A[2] * v[2],
      A[3] * v[0] + A[4] * v[1] + A[5] * v[2],
      A[6] * v[0] + A[7] * v[1] + A[8] * v[2],
    ];
  }

  // World→camera rotation W = Rx(el)·Ry(az). Proper rotation (det = +1); +z is
  // forward. A world offset is rotated by this, then pushed +R down camera z so
  // the target sits distance R in front of the camera at the origin.
  function camMatrix(az: number, el: number): Mat3 {
    const ca = Math.cos(az), sa = Math.sin(az);
    const ce = Math.cos(el), se = Math.sin(el);
    return [
      ca, 0, sa,
      sa * se, ce, -ca * se,
      -sa * ce, se, ca * ce,
    ];
  }

  // ── Canvas / render config ───────────────────────────────────────────
  const W = 360, H = 240;
  const CX = W / 2, CY = H / 2;
  const FOCAL = 340;      // pixels
  const CAM_R = 6;        // camera distance from target
  const EPS_Z = 0.05;     // cull Gaussians at/behind the camera (z <= eps)
  const BG: RGB = [0.980, 0.980, 0.980]; // #fafafa, matches the site vizzes

  type Item = {
    idx: number; z: number; sx: number; sy: number;
    inv: Mat2; cov2: Mat2; color: RGB; opacity: number;
  };

  // An Astro bundled <script> runs once per page, so ALL mutable per-instance
  // state (scene, view angles, selection, accumulation buffers) lives inside
  // init() below, one closure per mounted component so multiple embeds on the
  // same page never share a scene or clobber each other's pixel buffers.
  document.querySelectorAll<HTMLElement>('.gslab').forEach(init);

  function init(root: HTMLElement) {
    const base = root.querySelector<HTMLCanvasElement>('.gs-canvas')!;
    const overlay = root.querySelector<HTMLCanvasElement>('.gs-overlay')!;
    const ctx = base.getContext('2d')!;
    const octx = overlay.getContext('2d')!;
    const img = ctx.createImageData(W, H);

    // ── Per-instance mutable state (scoped so multiple mounts stay isolated) ──
    let splats: Splat[] = defaultScene();
    let selected = -1;
    let az = 0.6, el = 0.35;
    let showEllipses = false;
    let lastItems: Item[] = [];
    // Accumulation buffers (premultiplied colour + accumulated alpha), reused.
    const accR = new Float32Array(W * H);
    const accG = new Float32Array(W * H);
    const accB = new Float32Array(W * H);
    const accA = new Float32Array(W * H);

    const alongEl = root.querySelector<HTMLInputElement>('.gs-along')!;
    const acrossEl = root.querySelector<HTMLInputElement>('.gs-across')!;
    const opacityEl = root.querySelector<HTMLInputElement>('.gs-opacity')!;
    const ellipsesEl = root.querySelector<HTMLInputElement>('.gs-ellipses')!;
    const addEl = root.querySelector<HTMLButtonElement>('.gs-add')!;
    const removeEl = root.querySelector<HTMLButtonElement>('.gs-remove')!;
    const resetEl = root.querySelector<HTMLButtonElement>('.gs-reset')!;
    const readoutEl = root.querySelector<HTMLElement>('.gs-readout')!;

    // rAF-coalesced draw so drags stay smooth without a permanent loop.
    let pending = false;
    function scheduleRender() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => { pending = false; render(); });
    }

    function syncControls() {
      const has = selected >= 0 && selected < splats.length;
      alongEl.disabled = acrossEl.disabled = opacityEl.disabled = !has;
      removeEl.disabled = !has;
      if (has) {
        const s = splats[selected];
        alongEl.value = String(s.scale[0]);
        acrossEl.value = String(s.scale[1]);
        opacityEl.value = String(s.opacity);
        readoutEl.textContent = `Selected: Gaussian ${selected + 1} of ${splats.length}`;
      } else {
        readoutEl.textContent = `Selected: none · ${splats.length} Gaussians`;
      }
    }

    // ── Sliders bound to the selected Gaussian ────────────────────────
    alongEl.addEventListener('input', () => {
      if (selected < 0) return;
      splats[selected].scale[0] = parseFloat(alongEl.value);
      scheduleRender();
    });
    acrossEl.addEventListener('input', () => {
      if (selected < 0) return;
      // "width" drives the two cross-axes together (disc / cigar shaping).
      splats[selected].scale[1] = splats[selected].scale[2] = parseFloat(acrossEl.value);
      scheduleRender();
    });
    opacityEl.addEventListener('input', () => {
      if (selected < 0) return;
      splats[selected].opacity = parseFloat(opacityEl.value);
      scheduleRender();
    });
    ellipsesEl.addEventListener('change', () => {
      showEllipses = ellipsesEl.checked;
      scheduleRender();
    });

    // ── Buttons ───────────────────────────────────────────────────────
    addEl.addEventListener('click', () => {
      const jitter = () => (Math.random() - 0.5) * 0.5;
      splats.push({
        pos: [jitter(), jitter(), jitter()],
        scale: [0.5, 0.5, 0.5],
        quat: [1, 0, 0, 0],
        color: INK,
        opacity: 0.85,
      });
      selected = splats.length - 1;
      syncControls();
      scheduleRender();
    });
    removeEl.addEventListener('click', () => {
      if (selected < 0) return;
      splats.splice(selected, 1);
      selected = -1;
      syncControls();
      scheduleRender();
    });
    resetEl.addEventListener('click', () => {
      splats = defaultScene();
      selected = -1;
      az = 0.6; el = 0.35;
      syncControls();
      scheduleRender();
    });

    // ── Orbit + select via pointer ────────────────────────────────────
    let dragging = false;
    let lastX = 0, lastY = 0, moved = 0;
    base.addEventListener('pointerdown', (e) => {
      dragging = true; moved = 0;
      lastX = e.clientX; lastY = e.clientY;
      base.setPointerCapture(e.pointerId);
    });
    base.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      moved += Math.abs(dx) + Math.abs(dy);
      az += dx * 0.008;
      el = Math.max(-1.4, Math.min(1.4, el + dy * 0.008));
      scheduleRender();
    });
    base.addEventListener('pointerup', (e) => {
      dragging = false;
      base.releasePointerCapture(e.pointerId);
      if (moved < 5) selectAt(e.clientX, e.clientY);
    });

    function selectAt(clientX: number, clientY: number) {
      const rect = base.getBoundingClientRect();
      const ix = ((clientX - rect.left) / rect.width) * W;
      const iy = ((clientY - rect.top) / rect.height) * H;
      let best = -1, bestD = 16 * 16; // pixel threshold in internal coords
      for (const it of lastItems) {
        const d = (it.sx - ix) ** 2 + (it.sy - iy) ** 2;
        if (d < bestD) { bestD = d; best = it.idx; }
      }
      selected = best;
      syncControls();
      scheduleRender();
    }

    // ── Overlay sizing (crisp vector ellipses at display resolution) ──
    function sizeOverlay() {
      const rect = base.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      overlay.width = Math.max(1, Math.round(rect.width * dpr));
      overlay.height = Math.max(1, Math.round(rect.height * dpr));
      overlay.style.width = rect.width + 'px';
      overlay.style.height = rect.height + 'px';
    }
    sizeOverlay();
    window.addEventListener('resize', () => { sizeOverlay(); scheduleRender(); });

    syncControls();
    scheduleRender();

    // ── The render pipeline: transform → project → sort → composite ──────
    // Nested in init() so it closes over this instance's state and buffers.
    function render() {
    const Rc = camMatrix(az, el);
    const Rct = transpose3(Rc);

    // 1-4: transform every mean into camera space, cull, project covariance.
    const items: Item[] = [];
    for (let i = 0; i < splats.length; i++) {
      const s = splats[i];
      const rel: Vec3 = [s.pos[0], s.pos[1], s.pos[2]];
      const mc = mat3vec(Rc, rel);
      mc[2] += CAM_R; // push the target distance R in front of the camera
      if (mc[2] <= EPS_Z) continue; // cull at/behind camera (projectCovariance would NaN)

      const cov3 = covariance3D(s.scale, s.quat);
      const covCam = mat3mul(mat3mul(Rc, cov3), Rct); // Σ_cam = W Σ Wᵀ
      const cov2raw = projectCovariance(covCam, mc, FOCAL); // Σ' = J Σ_cam Jᵀ

      // Screen mean: +z forward, y up → flip y for image coords. The y-flip is
      // a reflection D = diag(1,-1); it negates the off-diagonal of Σ'.
      const sx = CX + FOCAL * (mc[0] / mc[2]);
      const sy = CY - FOCAL * (mc[1] / mc[2]);
      const cov2: Mat2 = [cov2raw[0], -cov2raw[1], -cov2raw[1], cov2raw[3]];
      const inv = invMat2(cov2);

      items.push({ idx: i, z: mc[2], sx, sy, inv, cov2, color: s.color, opacity: s.opacity });
    }

    // 5: sort near→far (ascending z) so front-to-back "over" accumulates right.
    items.sort((a, b) => a.z - b.z);

    accR.fill(0); accG.fill(0); accB.fill(0); accA.fill(0);

    for (const it of items) {
      // Axis-aligned bounding box of the 3σ ellipse: half-width in x is
      // 3·sqrt(Σ'_xx), in y is 3·sqrt(Σ'_yy). Conservative and exact for the box.
      const rx = Math.max(1, Math.ceil(3 * Math.sqrt(Math.max(it.cov2[0], 1e-6))));
      const ry = Math.max(1, Math.ceil(3 * Math.sqrt(Math.max(it.cov2[3], 1e-6))));
      const x0 = Math.max(0, Math.floor(it.sx - rx));
      const x1 = Math.min(W - 1, Math.ceil(it.sx + rx));
      const y0 = Math.max(0, Math.floor(it.sy - ry));
      const y1 = Math.min(H - 1, Math.ceil(it.sy + ry));
      const op = it.opacity;
      for (let py = y0; py <= y1; py++) {
        const dy = py - it.sy;
        const rowBase = py * W;
        for (let px = x0; px <= x1; px++) {
          const idx = rowBase + px;
          const dstA = accA[idx];
          if (dstA >= 0.999) continue; // pixel is saturated, skip
          const g = gaussian2D(px - it.sx, dy, it.inv);
          const srcA = op * g;
          if (srcA < 0.003) continue;
          // Front-to-back "over" from the tested lib (dst is the near-side accum).
          const res = alphaOver([accR[idx], accG[idx], accB[idx]], dstA, it.color, srcA);
          accR[idx] = res.rgb[0];
          accG[idx] = res.rgb[1];
          accB[idx] = res.rgb[2];
          accA[idx] = res.a;
        }
      }
    }

    // Composite onto the background: final = accRGB + (1 - accA)·bg.
    const data = img.data;
    for (let p = 0; p < W * H; p++) {
      const a = accA[p];
      const t = 1 - a;
      const r = accR[p] + t * BG[0];
      const g = accG[p] + t * BG[1];
      const b = accB[p] + t * BG[2];
      const o = p * 4;
      data[o] = Math.min(255, r * 255);
      data[o + 1] = Math.min(255, g * 255);
      data[o + 2] = Math.min(255, b * 255);
      data[o + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);

    lastItems = items;
    drawOverlay();
    }

    // ── Overlay: 1σ ellipses + the selection ring ────────────────────────
    function drawOverlay() {
    sizeOverlay();
    const s = overlay.width / W; // internal → overlay-pixel scale (uniform)
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    octx.clearRect(0, 0, overlay.width, overlay.height);

    if (showEllipses) {
      octx.lineWidth = 1.1 * dpr;
      for (const it of lastItems) {
        const a = it.cov2[0], b = it.cov2[1], d = it.cov2[3];
        const tr = a + d, det = a * d - b * b;
        const disc = Math.sqrt(Math.max(0, (tr * tr) / 4 - det));
        const l1 = tr / 2 + disc, l2 = tr / 2 - disc;
        const r1 = Math.sqrt(Math.max(l1, 0)); // 1σ major radius (px)
        const r2 = Math.sqrt(Math.max(l2, 0)); // 1σ minor radius (px)
        const theta = 0.5 * Math.atan2(2 * b, a - d);
        octx.strokeStyle = it.idx === selected ? 'rgba(48,68,96,0.9)' : 'rgba(28,28,30,0.5)';
        octx.beginPath();
        octx.ellipse(it.sx * s, it.sy * s, r1 * s, r2 * s, theta, 0, Math.PI * 2);
        octx.stroke();
      }
    }

    if (selected >= 0) {
      const it = lastItems.find((q) => q.idx === selected);
      if (it) {
        octx.strokeStyle = 'rgba(48,68,96,0.95)';
        octx.lineWidth = 1.6 * dpr;
        octx.beginPath();
        octx.arc(it.sx * s, it.sy * s, 11 * dpr, 0, Math.PI * 2);
        octx.stroke();
      }
    }
    }
  }
</script>

<style>
  .viz { margin: 1.5rem auto; max-width: 860px; }
  .viz-row { display: flex; gap: 1.6rem; align-items: center; justify-content: center; flex-wrap: wrap; }
  .viz-eq { flex: 0 1 auto; min-width: 0; margin: 0; }
  .gs-eqs { display: flex; flex-direction: column; gap: 1.25rem; }
  .gs-eq-line { overflow-x: auto; }
  .viz-render { flex: 0 0 380px; max-width: 100%; }
  .gs-stage {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 3 / 2;
  }
  .gs-canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 10px;
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.08);
    cursor: grab;
    touch-action: none;
  }
  .gs-canvas:active { cursor: grabbing; }
  .gs-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .viz-controls.gs-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.25rem;
    margin-top: 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-4);
  }
  .gs-hint { color: var(--color-ink-5); }
  .gs-field { display: inline-flex; align-items: center; gap: 0.45rem; }
  .gs-field input[type="range"] { accent-color: var(--color-ink); width: 92px; }
  .gs-field input:disabled { opacity: 0.4; }
  .gs-check { display: inline-flex; align-items: center; gap: 0.4rem; }
  .gs-check input { accent-color: var(--color-ink); }
  .gs-btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-ink-2);
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 7px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .gs-btn:hover { border-color: rgba(0, 0, 0, 0.28); color: var(--color-ink); }
  .gs-btn:disabled { opacity: 0.4; cursor: default; }
  .gs-readout { color: var(--color-ink-3); font-variant-numeric: tabular-nums; }
  .viz figcaption {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-ink-4);
    margin-top: 0.9rem;
    line-height: 1.55;
  }
</style>
