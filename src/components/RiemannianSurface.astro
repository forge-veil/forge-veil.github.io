---
interface Props {
  mode: 'flat' | 'bump' | 'distances' | 'curvature' | 'geodesic' | 'parallel-transport';
  height?: number;
  amp?: number;
  sigma?: number;
}
const { mode, height = 420, amp = 1.1, sigma = 0.8 } = Astro.props;
---

<div
  class="rs-wrap"
  data-mode={mode}
  data-amp={amp}
  data-sigma={sigma}
  style={`height: ${height}px`}
>
  <canvas class="rs-canvas"></canvas>
  <canvas class="rs-overlay"></canvas>
  <div class="rs-ui"></div>
</div>

<style>
  .rs-wrap {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #f9f9fb;
    border: 1px solid rgba(0,0,0,0.07);
    margin: 2rem 0;
  }
  .rs-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .rs-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .rs-ui {
    position: absolute;
    bottom: 12px;
    left: 16px;
    right: 16px;
    display: flex;
    gap: 12px;
    align-items: flex-end;
    pointer-events: none;
  }
  .rs-chip {
    font-family: 'Menlo', 'Courier New', monospace;
    font-size: 10.5px;
    color: #6e6e73;
    background: rgba(255,255,255,0.88);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 6px;
    padding: 3px 8px;
    backdrop-filter: blur(4px);
  }
  .rs-chip em { color: #1c1c1e; font-style: normal; }
  .rs-slider-row {
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: all;
    background: rgba(255,255,255,0.88);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 6px 12px;
    backdrop-filter: blur(4px);
  }
  .rs-slider-label { font-family: 'Geist', sans-serif; font-size: 11px; color: #6e6e73; }
  .rs-slider-row input[type=range] { width: 100px; accent-color: #1c1c1e; }
  .rs-slider-val { font-family: 'Menlo', monospace; font-size: 11px; color: #1c1c1e; min-width: 28px; }
</style>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import {
  surfaceZ, metricTensor, gaussianCurvature,
  computeGeodesic, parallelTransport
} from '../lib/riemann';

const GRID = 60;
const EXT  = 2.2;

document.querySelectorAll<HTMLElement>('.rs-wrap').forEach(wrap => {
  const mode  = wrap.dataset.mode!;
  const amp   = parseFloat(wrap.dataset.amp  ?? '1.1');
  const sigma = parseFloat(wrap.dataset.sigma ?? '0.8');
  initSurface(wrap, mode, amp, sigma);
});

function initSurface(wrap: HTMLElement, mode: string, amp: number, sigma: number) {
  const glCanvas = wrap.querySelector<HTMLCanvasElement>('.rs-canvas')!;
  const ovCanvas = wrap.querySelector<HTMLCanvasElement>('.rs-overlay')!;
  const uiDiv    = wrap.querySelector<HTMLElement>('.rs-ui')!;

  // ── Three.js setup ────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas: glCanvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setClearColor(0xf9f9fb, 1);

  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(40, 1, 0.01, 100);
  camera.position.set(0, 3.2, 4.5);
  camera.lookAt(0, 0, 0);

  const controls = new OrbitControls(camera, glCanvas);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.minPolarAngle = 0.1;
  controls.maxPolarAngle = Math.PI / 2;

  // ── Lighting ──────────────────────────────────────────────────────
  scene.add(new THREE.AmbientLight(0xffffff, 0.6));
  const sun = new THREE.DirectionalLight(0xffffff, 1.2);
  sun.position.set(3, 6, 4);
  scene.add(sun);

  // ── Surface geometry ──────────────────────────────────────────────
  const currentAmp = { value: amp };
  const geo = new THREE.PlaneGeometry(EXT*2, EXT*2, GRID, GRID);
  geo.rotateX(-Math.PI / 2);

  function updateGeometry(a: number) {
    const pos = geo.attributes.position as THREE.BufferAttribute;
    for (let i = 0; i < pos.count; i++) {
      const u = pos.getX(i), v = pos.getZ(i);
      pos.setY(i, mode === 'flat' ? 0 : surfaceZ(u, v, a, sigma));
    }
    pos.needsUpdate = true;
    geo.computeVertexNormals();
  }
  updateGeometry(amp);

  const mat = new THREE.MeshPhongMaterial({
    color: 0xf0f0f4,
    specular: 0x888888,
    shininess: 30,
    side: THREE.DoubleSide,
  });
  const mesh = new THREE.Mesh(geo, mat);
  scene.add(mesh);

  // ── Grid lines ────────────────────────────────────────────────────
  const gridLines = buildGridLines(mode === 'flat' ? 0 : amp, sigma, mode === 'flat');
  scene.add(gridLines);

  // ── Resize ────────────────────────────────────────────────────────
  function resize() {
    const w = wrap.clientWidth, h = wrap.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    const dpr = Math.min(devicePixelRatio, 2);
    ovCanvas.width  = Math.round(w * dpr);
    ovCanvas.height = Math.round(h * dpr);
    ovCanvas.style.width  = w + 'px';
    ovCanvas.style.height = h + 'px';
  }
  resize();
  const resizeController = new AbortController();
  window.addEventListener('resize', resize, { signal: resizeController.signal });

  // ── Mode dispatch ─────────────────────────────────────────────────
  let afterRender: (() => void) | null = null;

  if (mode === 'flat') afterRender = setupFlat(ovCanvas, camera);
  if (mode === 'bump')      setupBump(uiDiv, mesh, geo, sigma, currentAmp, gridLines);
  if (mode === 'distances') setupDistances(glCanvas, camera, scene, mesh, amp, sigma, uiDiv);
  if (mode === 'curvature') setupCurvature(glCanvas, camera, scene, mesh, geo, mat as THREE.MeshPhongMaterial, amp, sigma, uiDiv);

  // ── Render loop ───────────────────────────────────────────────────
  let animId: number | null = null;
  function tick() {
    animId = requestAnimationFrame(tick);
    controls.update();
    renderer.render(scene, camera);
    afterRender?.();
  }

  const observer = new IntersectionObserver(([entry]) => {
    if (entry.isIntersecting) { if (animId === null) tick(); }
    else { if (animId !== null) { cancelAnimationFrame(animId); animId = null; } }
  }, { threshold: 0 });
  observer.observe(wrap);

  // Dispose GL resources and listeners when the component is removed from the DOM
  new MutationObserver(() => {
    if (!document.contains(wrap)) {
      resizeController.abort();
      observer.disconnect();
      if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
      renderer.dispose();
      geo.dispose();
      mat.dispose();
    }
  }).observe(wrap.parentElement!, { childList: true });
}

// ── Grid line geometry ─────────────────────────────────────────────
function buildGridLines(amp: number, sigma: number, flat: boolean): THREE.LineSegments {
  const LINES = 16;
  const verts: number[] = [];
  const step  = (EXT*2) / LINES;

  for (let i = 0; i <= LINES; i++) {
    const u = -EXT + i*step;
    for (let j = 0; j < LINES; j++) {
      const v0 = -EXT + j*step, v1 = v0 + step;
      const y0 = flat ? 0 : surfaceZ(u, v0, amp, sigma);
      const y1 = flat ? 0 : surfaceZ(u, v1, amp, sigma);
      verts.push(u,y0,v0, u,y1,v1);
    }
  }
  for (let j = 0; j <= LINES; j++) {
    const v = -EXT + j*step;
    for (let i = 0; i < LINES; i++) {
      const u0 = -EXT + i*step, u1 = u0 + step;
      const y0 = flat ? 0 : surfaceZ(u0, v, amp, sigma);
      const y1 = flat ? 0 : surfaceZ(u1, v, amp, sigma);
      verts.push(u0,y0,v, u1,y1,v);
    }
  }

  const lineGeo = new THREE.BufferGeometry();
  lineGeo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
  return new THREE.LineSegments(lineGeo, new THREE.LineBasicMaterial({ color: 0xababba, linewidth: 1 }));
}

// ── Mode: flat ─────────────────────────────────────────────────────
function setupFlat(ovCanvas: HTMLCanvasElement, camera: THREE.PerspectiveCamera): () => void {
  const ctx = ovCanvas.getContext('2d')!;
  return () => {
    const dpr = Math.min(devicePixelRatio, 2);
    ctx.clearRect(0, 0, ovCanvas.width, ovCanvas.height);
    ctx.save();
    ctx.scale(dpr, dpr);
    const cW = ovCanvas.width / dpr;
    const cH = ovCanvas.height / dpr;

    const project = (x: number, y: number, z: number): [number, number] => {
      const v = new THREE.Vector3(x, y, z).project(camera);
      return [(v.x+1)/2*cW, (-v.y+1)/2*cH];
    };

    ctx.font = '12px Menlo, monospace';
    ctx.fillStyle = '#86868b';
    ctx.textAlign = 'center';
    const [ax, ay] = project(EXT*0.88, 0, 0);
    ctx.fillText('u¹', ax, ay - 6);
    const [bx, by] = project(0, 0, EXT*0.88);
    ctx.fillText('u²', bx + 8, by);
    ctx.restore();
  };
}

// ── Mode: bump ────────────────────────────────────────────────────
function setupBump(
  uiDiv: HTMLElement, mesh: THREE.Mesh,
  geo: THREE.BufferGeometry, sigma: number,
  currentAmp: { value: number }, gridLines: THREE.LineSegments
) {
  uiDiv.style.pointerEvents = 'all';
  uiDiv.innerHTML = `
    <div class="rs-slider-row">
      <span class="rs-slider-label">Bump height</span>
      <input type="range" min="0" max="2.2" step="0.01" value="${currentAmp.value}" id="rs-amp-slider-${Math.random().toString(36).slice(2)}">
      <span class="rs-slider-val">${currentAmp.value.toFixed(2)}</span>
    </div>`;

  const slider = uiDiv.querySelector<HTMLInputElement>('input[type=range]')!;
  const valSpan = uiDiv.querySelector<HTMLSpanElement>('.rs-slider-val')!;

  slider.addEventListener('input', () => {
    const a = parseFloat(slider.value);
    currentAmp.value = a;
    valSpan.textContent = a.toFixed(2);
    const pos = geo.attributes.position as THREE.BufferAttribute;
    for (let i = 0; i < pos.count; i++) {
      const u = pos.getX(i), v = pos.getZ(i);
      pos.setY(i, surfaceZ(u, v, a, sigma));
    }
    pos.needsUpdate = true;
    geo.computeVertexNormals();

    // Rebuild grid lines
    const newLines = buildGridLines(a, sigma, false);
    const lGeo = gridLines.geometry as THREE.BufferGeometry;
    lGeo.setAttribute('position', newLines.geometry.getAttribute('position'));
    lGeo.attributes.position.needsUpdate = true;
  });
}

// ── Mode: distances ───────────────────────────────────────────────
function setupDistances(
  glCanvas: HTMLCanvasElement, camera: THREE.PerspectiveCamera,
  scene: THREE.Scene, mesh: THREE.Mesh,
  amp: number, sigma: number, uiDiv: HTMLElement
) {
  const raycaster = new THREE.Raycaster();
  const dotGeo    = new THREE.SphereGeometry(0.04, 8, 8);
  const dotMat    = new THREE.MeshBasicMaterial({ color: 0x1c1c1e });
  const points: THREE.Vector3[] = [];
  const dots: THREE.Mesh[]      = [];
  let lineObj: THREE.Line | null = null;

  glCanvas.addEventListener('click', (e) => {
    if (points.length >= 2) {
      points.length = 0;
      dots.forEach(d => scene.remove(d));
      dots.length = 0;
      if (lineObj) { scene.remove(lineObj); lineObj = null; }
      uiDiv.innerHTML = '';
    }
    const rect = glCanvas.getBoundingClientRect();
    const ndc  = new THREE.Vector2(
      (e.clientX - rect.left) / rect.width  * 2 - 1,
      -(e.clientY - rect.top) / rect.height * 2 + 1
    );
    raycaster.setFromCamera(ndc, camera);
    const hits = raycaster.intersectObject(mesh);
    if (!hits.length) return;
    const pt = hits[0].point;
    points.push(pt);

    const dot = new THREE.Mesh(dotGeo, dotMat);
    dot.position.copy(pt);
    scene.add(dot);
    dots.push(dot);

    if (points.length === 2) {
      const [p0, p1] = points;
      const lGeo = new THREE.BufferGeometry().setFromPoints([p0, p1]);
      lineObj = new THREE.Line(lGeo, new THREE.LineBasicMaterial({ color: 0x1c1c1e }));
      scene.add(lineObj);

      const u  = (p0.x + p1.x) / 2, v = (p0.z + p1.z) / 2;
      const du = p1.x - p0.x,       dv = p1.z - p0.z;
      const g  = metricTensor(u, v, amp, sigma);
      const ds2 = g[0][0]*du*du + 2*g[0][1]*du*dv + g[1][1]*dv*dv;
      uiDiv.innerHTML = `
        <div class="rs-chip">ds² = <em>${ds2.toFixed(4)}</em></div>
        <div class="rs-chip">g₁₁ = <em>${g[0][0].toFixed(3)}</em></div>
        <div class="rs-chip">g₁₂ = <em>${g[0][1].toFixed(3)}</em></div>
        <div class="rs-chip">g₂₂ = <em>${g[1][1].toFixed(3)}</em></div>`;
    }
  });
}

// ── Mode: curvature ───────────────────────────────────────────────
function setupCurvature(
  glCanvas: HTMLCanvasElement, camera: THREE.PerspectiveCamera,
  scene: THREE.Scene, mesh: THREE.Mesh,
  geo: THREE.BufferGeometry, mat: THREE.MeshPhongMaterial,
  amp: number, sigma: number, uiDiv: HTMLElement
) {
  mat.vertexColors = true;
  mat.needsUpdate  = true;

  const pos    = geo.attributes.position as THREE.BufferAttribute;
  const colors = new Float32Array(pos.count * 3);
  const kVals: number[] = [];

  let kMin = Infinity, kMax = -Infinity;
  for (let i = 0; i < pos.count; i++) {
    const k = gaussianCurvature(pos.getX(i), pos.getZ(i), amp, sigma);
    kVals.push(k);
    kMin = Math.min(kMin, k); kMax = Math.max(kMax, k);
  }

  for (let i = 0; i < pos.count; i++) {
    const t = (kVals[i] - kMin) / (kMax - kMin + 1e-12);
    // blue-grey (flat) → warm red (peaked)
    const r = t < 0.5 ? 0.78 + 0.44*t*2                : 0.78 + 0.44*(1-(t-0.5)*2)*0.5 + 0.56;
    const g = t < 0.5 ? 0.82 + 0.18*t*2 - 0.3*t        : 0.82 - 0.53*(t-0.5)*2;
    const b = t < 0.5 ? 0.92 - 0.22*t*2                 : 0.90 - 0.87*(t-0.5)*2;
    colors[i*3]   = Math.min(1, Math.max(0, r));
    colors[i*3+1] = Math.min(1, Math.max(0, g));
    colors[i*3+2] = Math.min(1, Math.max(0, b));
  }
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const raycaster = new THREE.Raycaster();
  uiDiv.innerHTML = `<div class="rs-chip">Hover to read K &nbsp;·&nbsp; blue = flat · red = peaked</div>`;

  glCanvas.addEventListener('mousemove', (e) => {
    const rect = glCanvas.getBoundingClientRect();
    const ndc  = new THREE.Vector2(
      (e.clientX - rect.left) / rect.width  * 2 - 1,
      -(e.clientY - rect.top) / rect.height * 2 + 1
    );
    raycaster.setFromCamera(ndc, camera);
    const hits = raycaster.intersectObject(mesh);
    if (!hits.length) {
      uiDiv.innerHTML = `<div class="rs-chip">Hover to read K &nbsp;·&nbsp; blue = flat · red = peaked</div>`;
      return;
    }
    const pt = hits[0].point;
    const k  = gaussianCurvature(pt.x, pt.z, amp, sigma);
    uiDiv.innerHTML = `<div class="rs-chip">K = <em>${k.toFixed(4)}</em> at (${pt.x.toFixed(2)}, ${pt.z.toFixed(2)})</div>`;
  });
}
</script>
