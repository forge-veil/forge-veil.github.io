---
import KleinBottle from './KleinBottle.astro';
---
<div class="shape-carousel">
  <div class="carousel-slides">
    <div class="carousel-slide" data-index="0">
      <KleinBottle />
    </div>
    <!--
      To add a new shape:
      1. Create src/components/YourShape.astro (same structure as KleinBottle.astro)
      2. Import it above in the frontmatter
      3. Add a slide div:
           <div class="carousel-slide" data-index="1">
             <YourShape />
           </div>
      4. Add a dot:
           <button class="carousel-dot" data-index="1" aria-label="Shape 2"></button>
    -->
  </div>
  <div class="carousel-controls">
    <button class="carousel-prev" aria-label="Previous shape">‹</button>
    <div class="carousel-dots" aria-hidden="true">
      <button class="carousel-dot" data-index="0" aria-label="Shape 1"></button>
    </div>
    <button class="carousel-next" aria-label="Next shape">›</button>
  </div>
</div>

<script>
const slides  = document.querySelectorAll<HTMLElement>('.carousel-slide');
const dots    = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');
const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-prev');
const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-next');
let current   = 0;
let timer: ReturnType<typeof setInterval> | null = null;

function goTo(i: number) {
  slides[current].removeAttribute('data-active');
  dots[current].removeAttribute('data-active');
  current = (i + slides.length) % slides.length;
  slides[current].setAttribute('data-active', '');
  dots[current].setAttribute('data-active', '');
}

function resetTimer() {
  if (timer) clearInterval(timer);
  if (slides.length > 1) {
    timer = setInterval(() => goTo(current + 1), 6000);
  }
}

goTo(0);
resetTimer();

prevBtn?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
nextBtn?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); resetTimer(); }));
</script>
