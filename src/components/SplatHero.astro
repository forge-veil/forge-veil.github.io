---
// src/components/SplatHero.astro
// Ambient, non-interactive centrepiece for the top of "Painting with
// Gaussians": a REAL photogrammetry-captured Gaussian splat scene, "Sunflowers
// in a stone jug" by alfred2010 (CC BY 4.0), authored in PlayCanvas SuperSplat
// and exported as SOGS v2. The full capture (all 336,939 splats) was decoded
// and baked, upright, into public/hero.splat (the widely supported antimatter15
// .splat format).
//
// This renders the splats PHOTOREALISTICALLY on the GPU with Spark
// (@sparkjsdev/spark), World Labs' maintained Gaussian-splat renderer for
// three.js. Spark adds a SplatMesh to an ordinary three.js scene and handles
// the GPU sorting and EWA splat rasterisation itself, so there is no
// hand-rolled shader here. The scene turns slowly on its own and the reader can
// grab it (drag to orbit, scroll to zoom), so they see the payoff, a real
// captured scene, before the post unpacks the math.
interface Props {
  side?: boolean;
}
const { side = false } = Astro.props;
---
<figure class={`sh-fig${side ? ' sh-side' : ''}`}>
  <div class="sh-wrap">
    <canvas class="sh-canvas"></canvas>
  </div>
  <figcaption class="sh-cap">
    Scene: <a href="https://superspl.at/scene/e2879fc1" target="_blank" rel="noopener noreferrer">&ldquo;Sunflowers in a stone jug&rdquo;</a> by alfred2010 (<a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>)
  </figcaption>
</figure>

<script>
  // ── Framing constants ───────────────────────────────────────────────
  // The baked scene (public/hero.splat) is roughly centred on the origin
  // with a vertical half-extent of about 1.45 units. The camera orbits the
  // vertical axis at a fixed radius / elevation, looking at a target a touch
  // above the origin so the bouquet sits centred in the portrait frame.
  const CAM_R = 7.0;          // camera distance from target (pulled back so the
                              // full bouquet clears the frame at every angle)
  const CAM_EL = 0.14;        // gentle downward tilt (radians)
  const CAM_FOV = 42;         // vertical field of view (degrees)
  const TARGET_Y = 0.05;      // look slightly above the origin
  const AZ_START = Math.PI;   // start on the flowers-facing side
  const MAX_DPR = 2;          // cap devicePixelRatio for fragment cost
  const HERO_ROT = [0, 0, -0.4]; // tilt correction (Euler XYZ, radians)

  const REDUCE_MOTION =
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // An Astro bundled <script> runs once per page, so ALL per-instance state
  // lives inside init(), one closure per mounted component; multiple embeds
  // never share renderer state.
  document.querySelectorAll<HTMLElement>('.sh-wrap').forEach(init);

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.sh-canvas')!;

    // ── Per-instance mutable state ─────────────────────────────────────
    let started = false;      // heavy init (import + GPU) has begun
    let ready = false;        // splat loaded, first frame drawn
    let isVisible = false;
    let rafId = 0;
    let renderer: any = null;
    let sparkScene: any = null;
    let camera: any = null;
    let controls: any = null;

    function resize() {
      if (!renderer || !camera) return;
      const dpr = Math.min(MAX_DPR, window.devicePixelRatio || 1);
      const w = Math.max(1, canvas.clientWidth);
      const h = Math.max(1, canvas.clientHeight);
      renderer.setPixelRatio(dpr);
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }

    function draw() {
      if (!renderer || !sparkScene || !camera) return;
      resize();
      if (controls) controls.update();
      renderer.render(sparkScene, camera);
    }

    // ── Render loop (damping + optional auto orbit), paused off-screen ──
    function frame() {
      draw();
      rafId = requestAnimationFrame(frame);
    }
    function start() {
      if (rafId || !ready || !isVisible) return;
      rafId = requestAnimationFrame(frame);
    }
    function stop() {
      if (!rafId) return;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    // ── Heavy, lazy initialisation ─────────────────────────────────────
    // Dynamically import three + Spark and fetch the multi-MB asset only
    // when the hero nears the viewport, so the initial page paint is never
    // blocked. Any failure (no WebGL2, import error, bad asset) leaves a
    // blank #fafafa canvas plus the caption, never a crash.
    async function boot() {
      if (started) return;
      started = true;
      try {
        const three = await import('three');
        const { SparkRenderer, SplatMesh } = await import('@sparkjsdev/spark');
        const { OrbitControls } = await import('three/addons/controls/OrbitControls.js');

        renderer = new three.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          premultipliedAlpha: true,
        });
        renderer.setClearColor(0x000000, 0);

        sparkScene = new three.Scene();
        camera = new three.PerspectiveCamera(CAM_FOV, 1, 0.05, 200);
        camera.position.set(
          CAM_R * Math.cos(CAM_EL) * Math.sin(AZ_START),
          TARGET_Y + CAM_R * Math.sin(CAM_EL),
          CAM_R * Math.cos(CAM_EL) * Math.cos(AZ_START),
        );

        // Orbit + zoom + pan. Damped, with a gentle idle auto orbit that the
        // reader can grab and take over (drag to orbit, scroll to zoom).
        controls = new OrbitControls(camera, canvas);
        controls.target.set(0, TARGET_Y, 0);
        controls.enableDamping = true;
        controls.dampingFactor = 0.08;
        controls.enablePan = true;
        controls.enableZoom = true;
        controls.minDistance = CAM_R * 0.3;
        controls.maxDistance = CAM_R * 2.4;
        controls.autoRotate = !REDUCE_MOTION; // idle spin, off for reduce-motion
        controls.autoRotateSpeed = 0.8;
        controls.update();

        const spark = new SparkRenderer({ renderer });
        sparkScene.add(spark);

        const mesh = new SplatMesh({
          url: `${import.meta.env.BASE_URL}hero.splat`,
        });
        // Baked up = +Y. HERO_ROT is a fine tilt correction (Euler XYZ radians)
        // that brings the real capture's true up onto vertical.
        mesh.rotation.set(HERO_ROT[0], HERO_ROT[1], HERO_ROT[2]);
        sparkScene.add(mesh);

        await mesh.initialized;

        ready = true;
        resize();
        draw(); // first paint, also the reduced-motion single static frame
        if (isVisible) start();
      } catch {
        // Leave the blank canvas + caption in place.
        stop();
      }
    }

    // ── Lazy-load + visibility ─────────────────────────────────────────
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            boot();
            start();
          } else {
            stop();
          }
        }
      },
      { threshold: 0.01, rootMargin: '200px' },
    );
    observer.observe(canvas);

    window.addEventListener('resize', () => {
      if (ready && (REDUCE_MOTION || !rafId)) draw();
    });
  }
</script>

<style>
  .sh-fig {
    margin: 0 auto 2rem;
    max-width: 280px;
  }
  .sh-side {
    float: right;
    width: 42%;
    max-width: none;
    margin: 0.25rem 0 1.5rem 2rem;
  }
  @media (max-width: 860px) {
    .sh-side {
      float: none;
      width: 100%;
      max-width: 280px;
      margin: 0 auto 2rem;
    }
  }
  .sh-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 200 / 240;
  }
  .sh-canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 10px;
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .sh-cap {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-ink-5);
    text-align: center;
    margin-top: 0.5rem;
  }
  .sh-cap a {
    color: var(--color-ink-5);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
