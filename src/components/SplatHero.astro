---
// src/components/SplatHero.astro
// Ambient, non-interactive centrepiece for the top of "Painting with
// Gaussians": a small potted plant, built from about a thousand anisotropic
// Gaussians (a flat ground patch, a tapered pot, a rounded foliage canopy,
// and a handful of upright leaf blades), slowly turning in place. The
// Gaussians are kept small and dense so the scene resolves crisp detail (a
// clean pot taper and rim, distinct leaves, a smooth ground) rather than a
// coarse blob. It reuses the exact same transform -> project -> sort ->
// composite pipeline as GaussianSplatLab (../lib/splat), just without
// controls, so the reader sees the payoff, a small captured scene, before
// the post unpacks the math.
interface Props {
  side?: boolean;
}
const { side = false } = Astro.props;
---
<div class={`sh-wrap${side ? ' sh-side' : ''}`}>
  <canvas class="sh-canvas" width="200" height="240"></canvas>
</div>

<script>
  import {
    covariance3D,
    projectCovariance,
    invMat2,
    gaussian2D,
    alphaOver,
  } from '../lib/splat';
  import type { Vec3, Mat3, Mat2, Quat, RGB } from '../lib/splat';

  // ── Scene model (same shape as GaussianSplatLab) ─────────────────────
  type Splat = { pos: Vec3; scale: Vec3; quat: Quat; color: RGB; opacity: number };

  // Muted palette: a neutral ground tone, a desaturated terracotta pot, and
  // a desaturated sage foliage, matching the restrained accents in the lab.
  const GROUND: RGB = [0.40, 0.40, 0.43];
  const GROUND_DARK: RGB = [0.32, 0.32, 0.36];
  const POT: RGB = [0.55, 0.34, 0.24];
  const POT_DARK: RGB = [0.46, 0.28, 0.20];
  const POT_LIGHT: RGB = [0.62, 0.40, 0.29];
  const SAGE: RGB = [0.34, 0.42, 0.30];
  const SAGE_DARK: RGB = [0.26, 0.33, 0.24];
  const SAGE_LIGHT: RGB = [0.47, 0.56, 0.40];

  // Unit-axis, angle → quaternion [w,x,y,z].
  function qAxis(ax: number, ay: number, az: number, angle: number): Quat {
    const h = angle / 2, s = Math.sin(h);
    return [Math.cos(h), ax * s, ay * s, az * s];
  }

  // Deterministic PRNG (mulberry32). The hero's arrangement is fixed by a
  // hardcoded seed, not Math.random, so the layout never changes between
  // builds or page loads.
  function mulberry32(seed: number) {
    let a = seed >>> 0;
    return function () {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // Hardcoded, deterministic layout: a small captured scene, a potted
  // plant, built from a flat ground patch, a tapered pot, a rounded foliage
  // canopy, and a handful of upright leaf blades, so the composited cloud
  // reads as "a plant in a pot on the ground" rather than an abstract
  // blob. Built once from a fixed seed.
  function heroScene(): Splat[] {
    const rnd = mulberry32(20260709);
    const splats: Splat[] = [];

    // Rounded organic blob cluster (used for the foliage canopy): random
    // axis tilt, points scattered in an ellipsoid via spherical coordinates.
    function cluster(
      count: number,
      center: Vec3,
      radii: Vec3,
      baseScale: number,
      scaleJitter: number,
      colors: RGB[],
    ) {
      for (let i = 0; i < count; i++) {
        // Deterministic point inside a unit ball via spherical coordinates.
        const theta = rnd() * Math.PI * 2;
        const phi = Math.acos(2 * rnd() - 1);
        const r = Math.cbrt(rnd());
        const px = r * Math.sin(phi) * Math.cos(theta);
        const py = r * Math.sin(phi) * Math.sin(theta);
        const pz = r * Math.cos(phi);
        const pos: Vec3 = [
          center[0] + px * radii[0],
          center[1] + py * radii[1],
          center[2] + pz * radii[2],
        ];
        // Anisotropic: one long axis, two shorter cross axes, random tilt.
        const along = baseScale * (1 + (rnd() - 0.5) * scaleJitter);
        const across = along * (0.32 + rnd() * 0.4);
        const ax = rnd() - 0.5, ay = rnd() - 0.5, az = rnd() - 0.5;
        const alen = Math.hypot(ax, ay, az) || 1;
        const quat = qAxis(ax / alen, ay / alen, az / alen, rnd() * Math.PI);
        const color = colors[Math.floor(rnd() * colors.length)];
        const opacity = 0.68 + rnd() * 0.24;
        splats.push({ pos, scale: [along, across, across], quat, color, opacity });
      }
    }

    // Flat, wide, near-horizontal disk splats forming the ground patch.
    // Near-identity quaternion (slight jitter) so the tiny axis stays close
    // to world-up: this is what makes the ground read as a receding surface,
    // not a hard slab.
    function groundPatch(count: number, center: Vec3, radius: number, colors: RGB[]) {
      for (let i = 0; i < count; i++) {
        const theta = rnd() * Math.PI * 2;
        const r = Math.sqrt(rnd()) * radius;
        const pos: Vec3 = [
          center[0] + Math.cos(theta) * r,
          center[1] + (rnd() - 0.5) * 0.03,
          center[2] + Math.sin(theta) * r,
        ];
        const wide = 0.15 + rnd() * 0.13;
        const thin = 0.02 + rnd() * 0.015;
        const jitter = (rnd() - 0.5) * 0.25;
        const quat = qAxis(1, 0, 0, jitter);
        const color = colors[Math.floor(rnd() * colors.length)];
        const opacity = 0.22 + rnd() * 0.16;
        splats.push({ pos, scale: [wide, thin, wide], quat, color, opacity });
      }
    }

    // Tapered pot: a cluster of splats sampled over a truncated-cone shell,
    // wider at the rim (top) than at the base.
    function pot(
      count: number,
      baseCenter: Vec3,
      height: number,
      baseRadius: number,
      topRadius: number,
      colors: RGB[],
    ) {
      for (let i = 0; i < count; i++) {
        const t = rnd();
        const y = baseCenter[1] + t * height;
        const radius = baseRadius + (topRadius - baseRadius) * t;
        const theta = rnd() * Math.PI * 2;
        const rr = radius * (0.86 + rnd() * 0.2);
        const pos: Vec3 = [
          baseCenter[0] + Math.cos(theta) * rr,
          y,
          baseCenter[2] + Math.sin(theta) * rr,
        ];
        const baseScale = 0.09 + rnd() * 0.04;
        const across = baseScale * (0.55 + rnd() * 0.3);
        const ax = -Math.sin(theta), az = Math.cos(theta); // tangential axis
        const quat = qAxis(ax, (rnd() - 0.5) * 0.3, az, Math.PI / 2 + (rnd() - 0.5) * 0.4);
        const color = colors[Math.floor(rnd() * colors.length)];
        const opacity = 0.8 + rnd() * 0.18;
        splats.push({ pos, scale: [baseScale, across, across], quat, color, opacity });
      }
    }

    // Individual upright leaf blade: elongated vertical splat, base near the
    // canopy, tip leaning outward from a given azimuth. Purposefully
    // anisotropic (long vertical axis, thin cross-section) so the rendered
    // scene visibly teaches what an anisotropic Gaussian looks like.
    function leaf(base: Vec3, length: number, azimuth: number, lean: number, color: RGB) {
      const midHeight = length * 0.5 * Math.cos(lean);
      const midOut = length * 0.5 * Math.sin(lean);
      const pos: Vec3 = [
        base[0] + Math.cos(azimuth) * midOut,
        base[1] + midHeight,
        base[2] + Math.sin(azimuth) * midOut,
      ];
      const width = length * 0.09;
      // Leaf axis points mostly up (local y), leaning outward in the
      // azimuth direction: rotate the local y axis toward the
      // radial-outward vector.
      const axisX = Math.cos(azimuth) * Math.sin(lean);
      const axisZ = Math.sin(azimuth) * Math.sin(lean);
      const axisLen = Math.hypot(axisX, axisZ) || 1;
      const quat = qAxis(-axisZ / axisLen, 0, axisX / axisLen, lean);
      splats.push({
        pos,
        scale: [width * 0.4, length * 0.5, width],
        quat,
        color,
        opacity: 0.9,
      });
    }

    // Ground: a soft, roughly circular patch under the pot. Many small,
    // low-opacity disk splats build up a smooth surface rather than a few
    // coarse ones.
    groundPatch(180, [0, -1.08, 0], 0.95, [GROUND, GROUND, GROUND_DARK]);

    // Pot: tapered, wider rim than base, sitting on the ground. Kept
    // narrower than the foliage canopy above so its shoulders stay visible
    // beneath the bulge, and tall enough to read clearly as a pot.
    const POT_BASE_Y = -1.02;
    const POT_HEIGHT = 0.5;
    const POT_BASE_R = 0.22;
    const POT_TOP_R = 0.4;
    const POT_TOP_Y = POT_BASE_Y + POT_HEIGHT; // -0.52
    pot(300, [0, POT_BASE_Y, 0], POT_HEIGHT, POT_BASE_R, POT_TOP_R, [POT, POT_DARK, POT_LIGHT]);

    // A denser rim highlight ring so the pot's open top reads clearly.
    pot(60, [0, POT_TOP_Y - 0.03, 0], 0.05, POT_TOP_R * 0.97, POT_TOP_R * 1.03, [POT_LIGHT, POT]);

    // Foliage: a rounded canopy resting just above the pot rim. Narrower in
    // x/z than the pot's rim so the pot's shoulders peek out on the sides,
    // and its lower edge only slightly overlaps the rim, not the pot body,
    // so most of the pot stays visible below the greenery.
    const CANOPY_CENTER_Y = -0.06;
    cluster(340, [0, CANOPY_CENTER_Y, 0], [0.3, 0.34, 0.29], 0.24, 0.6, [SAGE, SAGE, SAGE_DARK, SAGE_LIGHT]);
    cluster(140, [0, CANOPY_CENTER_Y + 0.18, 0], [0.2, 0.18, 0.19], 0.18, 0.55, [SAGE_LIGHT, SAGE, SAGE_DARK]);

    // Leaf blades: a handful of upright anisotropic splats rooted near the
    // canopy's core, rising well beyond the rounded fill so their long,
    // thin silhouettes clearly break the canopy outline. Alternating
    // heights and lean angles for an asymmetric, plant-like fan.
    const leafAngles = [
      0.2, 0.6, 0.95, 1.35, 1.75, 2.15, 2.55, 2.95,
      3.35, 3.75, 4.15, 4.55, 4.95, 5.35, 5.75, 6.05,
    ];
    const leafColors = [SAGE_LIGHT, SAGE, SAGE_LIGHT, SAGE_DARK];
    for (let i = 0; i < leafAngles.length; i++) {
      const az = leafAngles[i];
      const tall = i % 2 === 0;
      const len = tall ? 0.6 + (i % 3) * 0.04 : 0.42 + (i % 3) * 0.05;
      const lean = tall ? 0.14 + (i % 3) * 0.05 : 0.4 + (i % 3) * 0.06;
      const rootR = 0.1 + (i % 4) * 0.03;
      const rootY = CANOPY_CENTER_Y + 0.1 + (i % 2) * 0.05;
      const base: Vec3 = [Math.cos(az) * rootR, rootY, Math.sin(az) * rootR];
      leaf(base, len, az, lean, leafColors[i % leafColors.length]);
    }

    return splats;
  }

  // ── Small matrix helpers (row-major flat 3x3), same as GaussianSplatLab ──
  function mat3mul(A: Mat3, B: Mat3): Mat3 {
    const C = new Array(9) as unknown as Mat3;
    for (let r = 0; r < 3; r++)
      for (let c = 0; c < 3; c++)
        C[r * 3 + c] = A[r * 3] * B[c] + A[r * 3 + 1] * B[3 + c] + A[r * 3 + 2] * B[6 + c];
    return C;
  }
  function transpose3(A: Mat3): Mat3 {
    return [A[0], A[3], A[6], A[1], A[4], A[7], A[2], A[5], A[8]];
  }
  function mat3vec(A: Mat3, v: Vec3): Vec3 {
    return [
      A[0] * v[0] + A[1] * v[1] + A[2] * v[2],
      A[3] * v[0] + A[4] * v[1] + A[5] * v[2],
      A[6] * v[0] + A[7] * v[1] + A[8] * v[2],
    ];
  }

  // World→camera rotation W = Rx(el)·Ry(az), same convention as the lab.
  function camMatrix(az: number, el: number): Mat3 {
    const ca = Math.cos(az), sa = Math.sin(az);
    const ce = Math.cos(el), se = Math.sin(el);
    return [
      ca, 0, sa,
      sa * se, ce, -ca * se,
      -sa * ce, se, ca * ce,
    ];
  }

  // ── Canvas / render config (modest internal resolution, CSS-scaled up) ──
  const W = 200, H = 240;
  const CX = W / 2, CY = H / 2;
  const FOCAL = 220;      // pixels
  const CAM_R = 6.4;      // camera distance from target
  const EPS_Z = 0.05;     // cull Gaussians at/behind the camera (z <= eps)
  const EL = 0.18;        // fixed, gentle downward camera tilt
  const AZ_RATE = 0.12;   // radians / second, slow continuous turn
  const BG: RGB = [0.980, 0.980, 0.980]; // #fafafa, matches the site vizzes

  type Item = { z: number; sx: number; sy: number; inv: Mat2; cov2: Mat2; color: RGB; opacity: number };

  const REDUCE_MOTION =
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // An Astro bundled <script> runs once per page, so ALL mutable per-instance
  // state (rotation angle, rAF id, observer, accumulation buffers) lives
  // inside init() below, one closure per mounted component so multiple
  // embeds on the same page never share state or clobber each other's pixels.
  document.querySelectorAll<HTMLElement>('.sh-wrap').forEach(init);

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.sh-canvas')!;
    const ctx = canvas.getContext('2d')!;
    const img = ctx.createImageData(W, H);

    // ── Per-instance mutable state ───────────────────────────────────────
    const splats = heroScene();
    let az = 0;
    let rafId = 0;
    let lastT = 0;
    const accR = new Float32Array(W * H);
    const accG = new Float32Array(W * H);
    const accB = new Float32Array(W * H);
    const accA = new Float32Array(W * H);

    // ── The render pipeline: transform → project → sort → composite ─────
    function render() {
      const Rc = camMatrix(az, EL);
      const Rct = transpose3(Rc);

      const items: Item[] = [];
      for (const s of splats) {
        const mc = mat3vec(Rc, s.pos);
        mc[2] += CAM_R; // push the target distance R in front of the camera
        if (mc[2] <= EPS_Z) continue; // cull at/behind camera

        const cov3 = covariance3D(s.scale, s.quat);
        const covCam = mat3mul(mat3mul(Rc, cov3), Rct); // Σ_cam = W Σ Wᵀ
        const cov2raw = projectCovariance(covCam, mc, FOCAL); // Σ' = J Σ_cam Jᵀ

        const sx = CX + FOCAL * (mc[0] / mc[2]);
        const sy = CY - FOCAL * (mc[1] / mc[2]); // y-flip: +y world up → image down
        const cov2: Mat2 = [cov2raw[0], -cov2raw[1], -cov2raw[1], cov2raw[3]];
        const inv = invMat2(cov2);

        items.push({ z: mc[2], sx, sy, inv, cov2, color: s.color, opacity: s.opacity });
      }

      items.sort((a, b) => a.z - b.z); // near→far so front-to-back "over" accumulates right

      accR.fill(0); accG.fill(0); accB.fill(0); accA.fill(0);

      for (const it of items) {
        const rx = Math.max(1, Math.ceil(3 * Math.sqrt(Math.max(it.cov2[0], 1e-6))));
        const ry = Math.max(1, Math.ceil(3 * Math.sqrt(Math.max(it.cov2[3], 1e-6))));
        const x0 = Math.max(0, Math.floor(it.sx - rx));
        const x1 = Math.min(W - 1, Math.ceil(it.sx + rx));
        const y0 = Math.max(0, Math.floor(it.sy - ry));
        const y1 = Math.min(H - 1, Math.ceil(it.sy + ry));
        const op = it.opacity;
        for (let py = y0; py <= y1; py++) {
          const dy = py - it.sy;
          const rowBase = py * W;
          for (let px = x0; px <= x1; px++) {
            const idx = rowBase + px;
            const dstA = accA[idx];
            if (dstA >= 0.999) continue;
            const g = gaussian2D(px - it.sx, dy, it.inv);
            const srcA = op * g;
            if (srcA < 0.003) continue;
            const res = alphaOver([accR[idx], accG[idx], accB[idx]], dstA, it.color, srcA);
            accR[idx] = res.rgb[0];
            accG[idx] = res.rgb[1];
            accB[idx] = res.rgb[2];
            accA[idx] = res.a;
          }
        }
      }

      const data = img.data;
      for (let p = 0; p < W * H; p++) {
        const a = accA[p];
        const t = 1 - a;
        const r = accR[p] + t * BG[0];
        const g = accG[p] + t * BG[1];
        const b = accB[p] + t * BG[2];
        const o = p * 4;
        data[o] = Math.min(255, r * 255);
        data[o + 1] = Math.min(255, g * 255);
        data[o + 2] = Math.min(255, b * 255);
        data[o + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);
    }

    // ── Rotation loop, paused off-screen ─────────────────────────────────
    function frame(t: number) {
      if (lastT === 0) lastT = t;
      const dt = (t - lastT) / 1000;
      lastT = t;
      az += AZ_RATE * dt;
      render();
      rafId = requestAnimationFrame(frame);
    }
    function start() {
      if (rafId || REDUCE_MOTION) return;
      lastT = 0;
      rafId = requestAnimationFrame(frame);
    }
    function stop() {
      if (!rafId) return;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }

    render(); // first paint, including the reduced-motion single static frame

    if (REDUCE_MOTION) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) start();
          else stop();
        }
      },
      { threshold: 0.01 },
    );
    observer.observe(canvas);
  }
</script>

<style>
  .sh-wrap {
    position: relative;
    width: 100%;
    max-width: 280px;
    margin: 0 auto 2rem;
    aspect-ratio: 200 / 240;
  }
  .sh-side {
    float: right;
    width: 42%;
    margin: 0.25rem 0 1.5rem 2rem;
  }
  @media (max-width: 860px) {
    .sh-side {
      float: none;
      width: 100%;
      max-width: 280px;
      margin: 0 auto 2rem;
    }
  }
  .sh-canvas {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 10px;
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
</style>
